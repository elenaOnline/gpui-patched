+    #[test]
+    fn test_live_region_and_disabled_builders() {
+        let mut element = div()
+            .id("status")
+            .aria_live(accesskit::Live::Polite)
+            .aria_value("Saved");
+        let mut node = accesskit::Node::new(accesskit::Role::Status);
+        element.interactivity().write_a11y_info(&mut node);
+        assert_eq!(node.live(), Some(accesskit::Live::Polite));
+        assert_eq!(node.value(), Some("Saved"));
+        assert!(!node.is_disabled());
+
+        let mut element = div().id("undo").aria_disabled(true);
+        let mut node = accesskit::Node::new(accesskit::Role::Button);
+        element.interactivity().write_a11y_info(&mut node);
+        assert!(node.is_disabled());
+        assert_eq!(node.live(), None);
+    }
+
+    struct A11yTestView {
+        clicks: Rc<Cell<usize>>,
+    }
+
+    impl Render for A11yTestView {
+        fn render(&mut self, _window: &mut Window, _cx: &mut Context<Self>) -> impl IntoElement {
+            let clicks = self.clicks.clone();
+            div().size_full().child(
+                div()
+                    .id("save")
+                    .role(accesskit::Role::Button)
+                    .aria_label("Save")
+                    .size(px(20.))
+                    .on_click(move |_, _, _| clicks.set(clicks.get() + 1)),
+            )
+        }
+    }
+
+    #[gpui::test]
+    fn test_window_reports_a11y_trees_and_takes_actions(cx: &mut TestAppContext) {
+        let clicks = Rc::new(Cell::new(0));
+        let window = cx.add_window({
+            let clicks = clicks.clone();
+            move |_, _| A11yTestView { clicks }
+        });
+        let window = AnyWindowHandle::from(window);
+        let draw = |cx: &mut TestAppContext| {
+            cx.update_window(window, |_, window, cx| window.draw(cx).clear(cx))
+                .unwrap();
+        };
+
+        draw(cx);
+        let updates = cx
+            .update_window(window, |_, window, _| window.take_a11y_tree_updates())
+            .unwrap();
+        assert!(
+            updates.is_empty(),
+            "no tree until assistive technology connects"
+        );
+
+        cx.update_window(window, |_, window, _| window.simulate_a11y_activation())
+            .unwrap();
+        cx.run_until_parked();
+        draw(cx);
+        let mut updates = cx
+            .update_window(window, |_, window, _| window.take_a11y_tree_updates())
+            .unwrap();
+        let update = updates.pop().expect("a tree once active");
+        let (save, node) = update
+            .nodes
+            .iter()
+            .find(|(_, node)| node.label() == Some("Save"))
+            .expect("the button's node");
+        assert_eq!(node.role(), accesskit::Role::Button);
+        assert!(node.supports_action(accesskit::Action::Click));
+
+        let save = *save;
+        cx.update_window(window, |_, window, cx| {
+            window.simulate_a11y_action(
+                accesskit::ActionRequest {
+                    action: accesskit::Action::Click,
+                    target_tree: accesskit::TreeId::ROOT,
+                    target_node: save,
+                    data: None,
+                },
+                cx,
+            )
+        })
+        .unwrap();
+        assert_eq!(clicks.get(), 1);
+
+        cx.update_window(window, |_, window, _| window.simulate_a11y_deactivation())
+            .unwrap();
+        cx.run_until_parked();
+        draw(cx);
+        let updates = cx
+            .update_window(window, |_, window, _| window.take_a11y_tree_updates())
+            .unwrap();
+        assert!(updates.is_empty(), "no trees once disconnected");
+    }
