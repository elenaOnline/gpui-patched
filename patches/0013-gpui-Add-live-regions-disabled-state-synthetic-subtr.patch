+    /// Connects assistive technology, as a screen reader starting does:
+    /// the window builds an accessibility tree from its next frame on.
+    /// Returns the tree the platform adapter is given at once (a root
+    /// placeholder until the next frame). `None` if the window has no
+    /// accessibility (see `Application::new_inaccessible`).
+    pub fn simulate_a11y_activation(&self) -> Option<accesskit::TreeUpdate> {
+        let callbacks = self.0.lock().a11y_callbacks.clone()?;
+        (callbacks.activation)()
+    }
+
+    /// Disconnects assistive technology.
+    pub fn simulate_a11y_deactivation(&self) {
+        let callbacks = self.0.lock().a11y_callbacks.clone();
+        if let Some(callbacks) = callbacks {
+            (callbacks.deactivation)();
+        }
+    }
+
+    /// Requests an action on a node, as a screen reader does (pressing a
+    /// button, focusing an item). It is handled when the foreground
+    /// executor runs next.
+    pub fn simulate_a11y_action(&self, request: accesskit::ActionRequest) {
+        let callbacks = self.0.lock().a11y_callbacks.clone();
+        if let Some(callbacks) = callbacks {
+            (callbacks.action)(request);
+        }
+    }
+
+    /// Takes the tree updates the window sent to the platform adapter since
+    /// the last call, oldest first.
+    pub fn take_a11y_tree_updates(&self) -> Vec<accesskit::TreeUpdate> {
+        std::mem::take(&mut self.0.lock().a11y_tree_updates)
+    }
 }
 
