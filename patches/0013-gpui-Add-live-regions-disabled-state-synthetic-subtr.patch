         self
     }
 
+    /// Make this element a live region (`aria-live`): assistive technology
+    /// announces its value when the element appears with a value, and
+    /// whenever its value changes, without moving focus to it.
+    ///
+    /// Put the text to announce in [`aria_value`][Self::aria_value]. To
+    /// announce the same text twice, remove the element (or clear its value)
+    /// for a frame in between, as web live regions need too.
+    fn aria_live(mut self, live: accesskit::Live) -> Self {
+        self.interactivity().aria.live = Some(live);
+        self
+    }
+
+    /// Report this element as disabled: assistive technology announces it as
+    /// dimmed or unavailable (the web's `aria-disabled`). This does not stop
+    /// its listeners from running.
+    fn aria_disabled(mut self, disabled: bool) -> Self {
+        self.interactivity().aria.disabled = disabled;
+        self
+    }
