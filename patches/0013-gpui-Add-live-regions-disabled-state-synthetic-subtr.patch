+    /// Add a synthetic node without making it a child of this element's node:
+    /// a deeper level of a synthetic subtree, which the caller attaches to a
+    /// synthetic child with [`accesskit::Node::set_children`] (for example
+    /// the text runs of a synthetic text field).
+    ///
+    /// Returns `false` if a node with this id is already present in the tree,
+    /// in which case the node is discarded.
+    pub fn push_node(&mut self, id: NodeId, node: accesskit::Node) -> bool {
+        let pushed = self.nodes.push_detached(id, node);
+        #[cfg(debug_assertions)]
+        if pushed {
+            self.nodes.record_node_info(
+                id,
+                debug::NodeDebugInfo {
+                    synthetic: true,
+                    view: self.creator.view,
+                    element_id: self.creator.element_id.clone(),
+                    source_location: self.creator.source_location,
+                },
+            );
+        }
+        pushed
+    }
+
+    /// Report the synthetic child `id` as the focused node, as
+    /// [`aria_active_descendant`][crate::StatefulInteractiveElement::aria_active_descendant]
+    /// does for real elements: honored only while this element or one of
+    /// its ancestors holds keyboard focus, so it is safe to call whenever
+    /// the child is the "current" item (e.g. the selected item of a
+    /// composite widget that keeps focus on its container).
+    ///
+    /// `id` must have been pushed with [`Self::push_child`] first.
+    pub fn set_active_descendant(&mut self, id: NodeId) {
+        if !self.nodes.has_node(id) {
+            debug_assert!(false, "set_active_descendant: {id:?} was not pushed");
+            return;
+        }
+        if self.nodes.focus_is_current_or_ancestor() {
+            self.nodes.set_active_descendant(id);
+        }
+    }
