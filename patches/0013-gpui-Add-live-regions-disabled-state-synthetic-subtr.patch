+    // A focused container reports a synthetic child as the active
+    // descendant; an unfocused one cannot.
+    #[test]
+    fn synthetic_child_active_descendant_follows_container_focus() {
+        use super::A11ySubtreeBuilder;
+        for focused in [true, false] {
+            let mut a11y = new_a11y();
+            let container = NodeId(1);
+            assert!(a11y.nodes.push(container, test_node()));
+            if focused {
+                a11y.set_focusable(container, FocusId::default());
+                a11y.set_focus(container);
+            }
+            let mut builder = A11ySubtreeBuilder::new(container, &mut a11y.nodes);
+            let item = builder.synthetic_node_id("item");
+            let run = builder.synthetic_node_id("run");
+            let mut field = test_node();
+            field.set_children(vec![run]);
+            assert!(builder.push_child(item, field));
+            // a deeper level: the item's child, not the container's
+            assert!(builder.push_node(run, accesskit::Node::new(Role::TextRun)));
+            assert!(!builder.push_node(run, accesskit::Node::new(Role::TextRun)));
+            builder.set_active_descendant(item);
+            a11y.nodes.pop(); // container
+
+            let update = a11y.end_frame(Default::default());
+            let expected = if focused { item } else { ROOT_NODE_ID };
+            assert_eq!(update.focus, expected, "focused: {focused}");
+            let children = |id| {
+                update
+                    .nodes
+                    .iter()
+                    .find(|(n, _)| *n == id)
+                    .map(|(_, node)| node.children().to_vec())
+                    .unwrap_or_default()
+            };
+            assert_eq!(children(container), [item]);
+            assert_eq!(children(item), [run]);
+        }
+    }
+
