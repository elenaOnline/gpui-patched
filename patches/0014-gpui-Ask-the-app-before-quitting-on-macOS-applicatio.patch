+/// `applicationShouldTerminate:`: asks the app ([`Platform::on_should_quit`]); without a
+/// callback, `NSTerminateNow`.
+extern "C" fn should_terminate(this: &mut Object, _: Sel, _: id) -> NSUInteger {
+    // NSApplicationTerminateReply
+    const NS_TERMINATE_CANCEL: NSUInteger = 0;
+    const NS_TERMINATE_NOW: NSUInteger = 1;
+    const NS_TERMINATE_LATER: NSUInteger = 2;
+    let platform = unsafe { get_mac_platform(this) };
+    let mut lock = platform.0.lock();
+    let Some(mut callback) = lock.should_quit.take() else {
+        return NS_TERMINATE_NOW;
+    };
+    drop(lock);
+    let response = callback();
+    platform.0.lock().should_quit.get_or_insert(callback);
+    match response {
+        QuitResponse::Now => NS_TERMINATE_NOW,
+        QuitResponse::Cancel => NS_TERMINATE_CANCEL,
+        QuitResponse::Later => NS_TERMINATE_LATER,
+    }
+}
+
