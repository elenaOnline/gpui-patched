+/// What an application answers when asked whether it may quit (see
+/// [`crate::App::on_should_quit`]; macOS `NSApplicationTerminateReply`).
+#[derive(Debug, Copy, Clone, Eq, PartialEq, Hash)]
+pub enum QuitResponse {
+    /// Quit now.
+    Now,
+    /// Do not quit (logging out, restarting or shutting down stops too).
+    Cancel,
+    /// Decide later (after asking the user): the application answers with
+    /// [`crate::App::reply_to_quit`]. Meanwhile it runs as usual; macOS
+    /// holds a logout, restart or shutdown until then.
+    Later,
+}
