     /// Gracefully quit the application via the platform's standard routine.
+    ///
+    /// On macOS this asks the handler set with [`Self::on_should_quit`] first, as every other
+    /// request to quit does.
     pub fn quit(&self) {
         self.platform.quit();
     }
 
+    /// Sets the handler asked whether the application may quit when something asks it to: on
+    /// macOS, `applicationShouldTerminate:` (the Quit menu item and [`Self::quit`], the Dock's
+    /// Quit, logging out, restarting or shutting down, an Apple Event such as AppleScript's
+    /// `quit`). It answers [`QuitResponse::Now`], [`QuitResponse::Cancel`] or
+    /// [`QuitResponse::Later`], and then, when it has decided (after asking about unsaved
+    /// changes, say), calls [`Self::reply_to_quit`]. Replaces an earlier handler. Without one
+    /// the application quits at once. Platforms that do not ask never call it.
+    pub fn on_should_quit(&mut self, handler: impl FnMut(&mut App) -> QuitResponse + 'static) {
+        self.should_quit_handler = Some(Box::new(handler));
+    }
+
+    /// Answers a quit request that the [`Self::on_should_quit`] handler put off with
+    /// [`QuitResponse::Later`]: `true` quits (the handlers of [`Self::on_app_quit`] run), `false`
+    /// cancels the quit (and a logout, restart or shutdown that asked).
+    pub fn reply_to_quit(&self, quit: bool) {
+        self.platform.reply_to_should_quit(quit);
+    }
+
+    fn should_quit(&mut self) -> QuitResponse {
+        let Some(mut handler) = self.should_quit_handler.take() else {
+            return QuitResponse::Now;
+        };
+        let response = handler(self);
+        // (unless the handler set another)
+        self.should_quit_handler.get_or_insert(handler);
+        response
+    }
+
     /// Returns the current policy for hiding the cursor in response to
     /// keyboard input.
     pub fn cursor_hide_mode(&self) -> CursorHideMode {
