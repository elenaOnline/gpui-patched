+        platform.on_should_quit(Box::new({
+            let cx = Rc::downgrade(&app);
+            let foreground_executor = app.borrow().foreground_executor.clone();
+            move || {
+                let Some(cx) = cx.upgrade() else {
+                    return QuitResponse::Now;
+                };
+                match cx.try_borrow_mut() {
+                    Ok(mut cx) => cx.update(|cx| cx.should_quit()),
+                    Err(_) => {
+                        // Asked while the app is being updated: ask again once it is free, and
+                        // answer then.
+                        let cx = Rc::downgrade(&cx);
+                        foreground_executor
+                            .spawn(async move {
+                                let Some(cx) = cx.upgrade() else {
+                                    return;
+                                };
+                                let mut cx = cx.borrow_mut();
+                                match cx.update(|cx| cx.should_quit()) {
+                                    QuitResponse::Now => cx.platform.reply_to_should_quit(true),
+                                    QuitResponse::Cancel => cx.platform.reply_to_should_quit(false),
+                                    QuitResponse::Later => {}
+                                }
+                            })
+                            .detach();
+                        QuitResponse::Later
+                    }
+                }
+            }
+        }));
+
         app
     }
 
