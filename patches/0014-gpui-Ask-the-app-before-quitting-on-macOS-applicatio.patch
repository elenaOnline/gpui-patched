@@ -645,4 +659,35 @@ mod tests {
             assert_eq!(global.0, "world");
         });
     }
+
+    #[test]
+    fn test_should_quit() {
+        use crate::QuitResponse;
+        let mut app = TestApp::new();
+        // no handler: quits at once
+        assert_eq!(app.simulate_quit_request(), QuitResponse::Now);
+
+        // a handler that asks first, then answers
+        let asked = std::rc::Rc::new(std::cell::Cell::new(0));
+        let count = asked.clone();
+        app.update(|cx| {
+            cx.on_should_quit(move |cx| {
+                count.set(count.get() + 1);
+                let task = cx.spawn(async move |cx| {
+                    cx.update(|cx| cx.reply_to_quit(false));
+                });
+                task.detach();
+                QuitResponse::Later
+            })
+        });
+        assert_eq!(app.simulate_quit_request(), QuitResponse::Later);
+        assert_eq!(asked.get(), 1);
+        assert_eq!(app.quit_replies(), [false]);
+
+        // replaced
+        app.update(|cx| cx.on_should_quit(|_| QuitResponse::Cancel));
+        assert_eq!(app.simulate_quit_request(), QuitResponse::Cancel);
+        assert_eq!(asked.get(), 1);
+        assert_eq!(app.quit_replies(), [false]);
+    }
 }
