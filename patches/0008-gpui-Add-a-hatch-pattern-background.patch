+    /// A hatch pattern whose edges are anti-aliased over `filter` device pixels instead of
+    /// one (at least one): how the pattern looks when it stands for a bitmap tile of it that
+    /// was resampled (as a browser draws a pattern image scaled). Other backgrounds are
+    /// returned unchanged.
+    pub fn hatch_filter(mut self, filter: f32) -> Self {
+        if self.tag == BackgroundTag::Hatch {
+            self.colors[1].percentage = filter.max(1.);
+        }
+        self
+    }
+
+    /// The window pixels → pattern space transform of a hatch pattern.
+    pub(crate) fn hatch_to_pattern(&self) -> Option<crate::TransformationMatrix> {
+        (self.tag == BackgroundTag::Hatch).then(|| {
+            let m = self.colors[1].color;
+            crate::TransformationMatrix {
+                rotation_scale: [
+                    [
+                        self.gradient_angle_or_pattern_height,
+                        self.colors[0].percentage,
+                    ],
+                    [m.h, m.s],
+                ],
+                translation: [m.l, m.a],
+            }
+        })
+    }
