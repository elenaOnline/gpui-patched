+    #[test]
+    fn test_hatch_pattern_keeps_its_transform() {
+        let to_pattern = crate::TransformationMatrix {
+            rotation_scale: [[0.125, -0.25], [0.5, 0.0625]],
+            translation: [3.5, -7.25],
+        };
+        let tile = hsla(0.1, 0.2, 0.9, 1.0);
+        let marks = hsla(0.6, 0.8, 0.4, 1.0);
+        let hatch = hatch_pattern(tile, marks, to_pattern);
+        assert_eq!(hatch.hatch_to_pattern(), Some(to_pattern));
+        assert_eq!(solid_background(tile).hatch_to_pattern(), None);
+
+        // Opacity fades both colours but not the transform.
+        let faded = hatch.opacity(0.5);
+        assert_eq!(faded.solid.a, 0.5);
+        assert_eq!(faded.colors[0].color.a, 0.5);
+        assert_eq!(faded.hatch_to_pattern(), Some(to_pattern));
+        assert!(!hatch.is_transparent());
+        assert!(hatch.opacity(0.).is_transparent());
+
+        // In device pixels the pattern shrinks by the scale factor.
+        let device = hatch.scale(2.).hatch_to_pattern().unwrap();
+        assert_eq!(device.rotation_scale, [[0.0625, -0.125], [0.25, 0.03125]]);
+        assert_eq!(device.translation, to_pattern.translation);
+        assert_eq!(solid_background(tile).scale(2.), solid_background(tile));
+
+        // A filter softens a hatch only, and never below a device pixel; it is a count of
+        // device pixels, which scaling leaves alone.
+        let soft = hatch.hatch_filter(2.5);
+        assert_eq!(soft.colors[1].percentage, 2.5);
+        assert_eq!(soft.hatch_to_pattern(), Some(to_pattern));
+        assert_eq!(soft.scale(2.).colors[1].percentage, 2.5);
+        assert_eq!(hatch.hatch_filter(0.5).colors[1].percentage, 1.);
+        assert_eq!(solid_background(tile).hatch_filter(3.), solid_background(tile));
+    }
 }
