+// How much the marks of a hatch background (`hatch_pattern`) cover the device pixel at
+// `position`. In pattern space every unit tile holds three round-capped dashes along its
+// descending diagonal; together the dashes form a lattice spanned by (1/3, 1/3) and (1, 0).
+// In coordinates along the ascending diagonal (d) and the dashes (e), they sit in rows
+// e = k/√2, at d = (1/3 + k + 2i/3)/√2, each half_length long and radius thick.
+float hatch_coverage(Background background, float2 position) {
+  float2 column0 = float2(background.gradient_angle_or_pattern_height, background.colors[1].color.h);
+  float2 column1 = float2(background.colors[0].percentage, background.colors[1].color.s);
+  float2 p = column0 * position.x + column1 * position.y +
+             float2(background.colors[1].color.l, background.colors[1].color.a);
+  // The size of a device pixel in pattern space, and the anti-aliasing footprint: a device
+  // pixel, or `hatch_filter` of them where the pattern stands for a resampled bitmap tile.
+  float pixel = max(length(column0), length(column1));
+  float footprint = pixel * max(background.colors[1].percentage, 1.);
+
+  const float sqrt2 = 1.41421356;
+  const float half_length = (2. / 12.) / sqrt2;
+  const float radius = 5. / 64.;
+  // The marks' share of a tile: what the pattern averages to when it's too fine to resolve.
+  const float average = 3. * (2. * half_length * 2. * radius + M_PI_F * radius * radius);
+
+  float d = (p.x + p.y) / sqrt2;
+  float e = (p.x - p.y) / sqrt2;
+  // The nearest dash is in one of the two rows around the point.
+  float distance = 1e9;
+  for (float k = floor(e * sqrt2); k <= floor(e * sqrt2) + 1.; k += 1.) {
+    float along = d * sqrt2 - 1. / 3. - k;
+    along -= round(along * 1.5) / 1.5;
+    float2 offset = float2(along / sqrt2, max(abs(e - k / sqrt2) - half_length, 0.));
+    distance = min(distance, length(offset) - radius);
+  }
+  // The share of a footprint-wide box across the nearest dash that the dash covers.
+  float h = footprint * 0.5;
+  float core = distance + radius;
+  float coverage = saturate((min(core + h, radius) - max(core - h, -radius)) / footprint);
+  return mix(coverage, average, smoothstep(2. * radius, 4. * radius, pixel));
+}
