+// How much the marks of a hatch background (`hatch_pattern`) cover the device pixel at
+// `position`. In pattern space every unit tile holds three round-capped dashes along its
+// descending diagonal; together the dashes form a lattice spanned by (1/3, 1/3) and (1, 0).
+// In coordinates along the ascending diagonal (d) and the dashes (e), they sit in rows
+// e = k/√2, at d = (1/3 + k + 2i/3)/√2, each half_length long and radius thick.
+fn hatch_coverage(background: Background, position: vec2<f32>) -> f32 {
+    let column0 = vec2<f32>(background.gradient_angle_or_pattern_height, background.colors[1].color.h);
+    let column1 = vec2<f32>(background.colors[0].percentage, background.colors[1].color.s);
+    let p = column0 * position.x + column1 * position.y
+        + vec2<f32>(background.colors[1].color.l, background.colors[1].color.a);
+    // The size of a device pixel in pattern space, and the anti-aliasing footprint: a device
+    // pixel, or `hatch_filter` of them where the pattern stands for a resampled bitmap tile.
+    let pixel = max(length(column0), length(column1));
+    let footprint = pixel * max(background.colors[1].percentage, 1.0);
+
+    let sqrt2 = 1.41421356;
+    let half_length = (2.0 / 12.0) / sqrt2;
+    let radius = 5.0 / 64.0;
+    // The marks' share of a tile: what the pattern averages to when it's too fine to resolve.
+    let average = 3.0 * (2.0 * half_length * 2.0 * radius + M_PI_F * radius * radius);
+
+    let d = (p.x + p.y) / sqrt2;
+    let e = (p.x - p.y) / sqrt2;
+    // The nearest dash is in one of the two rows around the point.
+    var distance = 1e9;
+    for (var row = 0; row < 2; row += 1) {
+        let k = floor(e * sqrt2) + f32(row);
+        var along = d * sqrt2 - 1.0 / 3.0 - k;
+        along -= round(along * 1.5) / 1.5;
+        let offset = vec2<f32>(along / sqrt2, max(abs(e - k / sqrt2) - half_length, 0.0));
+        distance = min(distance, length(offset) - radius);
+    }
+    // The share of a footprint-wide box across the nearest dash that the dash covers.
+    let h = footprint * 0.5;
+    let core = distance + radius;
+    let coverage = saturate((min(core + h, radius) - max(core - h, -radius)) / footprint);
+    return mix(coverage, average, smoothstep(2.0 * radius, 4.0 * radius, pixel));
+}
