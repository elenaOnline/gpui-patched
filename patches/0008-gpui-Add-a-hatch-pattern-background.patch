+/// Creates a hatch pattern background: three round-capped dashes along the
+/// descending diagonal of every tile, drawn in `marks` over `tile`, the way
+/// tldraw's `pattern` fill looks.
+///
+/// `to_pattern` maps window pixels (the space element bounds and paths are
+/// given in) to pattern space, where each tile is a unit square: the dashes
+/// run from `(1/12, 3/12)` to `(3/12, 1/12)`, `(5/12, 7/12)` to `(7/12, 5/12)`
+/// and `(9/12, 11/12)` to `(11/12, 9/12)`, `5/32` wide. Anchoring, scaling and
+/// rotating the pattern with the content it fills is a matter of
+/// `to_pattern`. Edges are anti-aliased over a device pixel, and where the
+/// dashes become thinner than a device pixel the pattern fades to its average
+/// colour instead of aliasing.
+pub fn hatch_pattern(
+    tile: impl Into<Hsla>,
+    marks: impl Into<Hsla>,
+    to_pattern: crate::TransformationMatrix,
+) -> Background {
+    let [[m00, m01], [m10, m11]] = to_pattern.rotation_scale;
+    let [t0, t1] = to_pattern.translation;
+    // The pattern transform is kept in the fields the other tags use for
+    // their parameters (see `Background::hatch_to_pattern`).
+    Background {
+        tag: BackgroundTag::Hatch,
+        solid: tile.into(),
+        gradient_angle_or_pattern_height: m00,
+        colors: [
+            LinearColorStop {
+                color: marks.into(),
+                percentage: m01,
+            },
+            LinearColorStop {
+                color: Hsla {
+                    h: m10,
+                    s: m11,
+                    l: t0,
+                    a: t1,
+                },
+                percentage: 0.,
+            },
+        ],
+        ..Default::default()
+    }
+}
+
 /// Creates a solid background color.
