+/// The public counterpart of AppKit's private diagonal window-resize cursors:
+/// `+[NSCursor frameResizeCursorFromPosition:inDirections:]` (macOS 15) for the top-left
+/// corner (`up_left`) or the top-right one, resizing either way. Earlier systems have no
+/// public diagonal resize cursor, and get the crosshair.
+#[cfg(feature = "app-store")]
+unsafe fn diagonal_resize_cursor(up_left: bool) -> id {
+    // NSCursorFrameResizePosition and NSCursorFrameResizeDirections (NSCursor.h).
+    const TOP: NSUInteger = 1 << 0;
+    const LEFT: NSUInteger = 1 << 1;
+    const RIGHT: NSUInteger = 1 << 3;
+    const INWARD_AND_OUTWARD: NSUInteger = (1 << 0) | (1 << 1);
+    // SAFETY: NSCursor class methods returning an autoreleased cursor; the first is sent
+    // only when NSCursor answers it.
+    unsafe {
+        let available: BOOL = msg_send![
+            class!(NSCursor),
+            respondsToSelector: sel!(frameResizeCursorFromPosition:inDirections:)
+        ];
+        if available == YES {
+            let position = if up_left { TOP | LEFT } else { TOP | RIGHT };
+            msg_send![
+                class!(NSCursor),
+                frameResizeCursorFromPosition: position
+                inDirections: INWARD_AND_OUTWARD
+            ]
+        } else {
+            msg_send![class!(NSCursor), crosshairCursor]
+        }
+    }
+}
