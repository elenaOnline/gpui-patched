+    #[cfg(feature = "app-store")]
+    fn open_with_system(&self, path: &Path) {
+        let path = path.to_owned();
+        self.0
+            .lock()
+            .background_executor
+            .spawn(async move {
+                let url = objc2_foundation::NSURL::from_file_path(&path);
