+// grows by a device pixel on every side and the fragment shader anti-aliases the edges (see
+// `transformed_quad_sdf`); an untransformed sprite keeps its exact quad.
+TransformedSpriteVertex transformed_sprite_vertex(float2 unit_vertex, Bounds bounds, TransformationMatrix transformation, AtlasTile tile) {
+    // One device pixel across the sprite's vertical and horizontal edges, in its own units.
+    float2 x_axis = mul(float2(1.0, 0.0), transformation.rotation_scale);
+    float2 y_axis = mul(float2(0.0, 1.0), transformation.rotation_scale);
+    float area = abs(x_axis.x * y_axis.y - x_axis.y * y_axis.x);
+    float2 margin = float2(0.0, 0.0);
+    if (!is_unit_transformation(transformation) && area > 0.0) {
+        margin = float2(length(y_axis), length(x_axis)) / area;
