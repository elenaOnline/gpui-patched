+    /// A transformed image keeps its exact bounds (the transformation places it), carries the
+    /// transformation and the element opacity to its sprite, and is culled and ordered by its
+    /// transformed bounds; an untransformed image stays snapped to device pixels.
+    #[gpui::test]
+    fn test_paint_image_transformed(cx: &mut TestAppContext) {
+        use crate::{Corners, RenderImage, TransformationMatrix, radians};
+        use image::Frame;
+
+        let image = std::sync::Arc::new(RenderImage::new(vec![Frame::new(image::RgbaImage::new(
+            4, 2,
+        ))]));
+        test_underline_paint_at_scales(cx, move |window| {
+            let scale = window.scale_factor();
+            let bounds = Bounds::new(point(px(-1.3), px(2.6)), size(px(10.2), px(5.1)));
+            let paint = |window: &mut Window, transformation| {
+                window.next_frame.scene.clear();
+                window
+                    .paint_image_transformed(
+                        bounds,
+                        bounds,
+                        Corners::default(),
+                        image.clone(),
+                        0,
+                        false,
+                        transformation,
+                    )
+                    .expect("image paints");
+                window.next_frame.scene.polychrome_sprites.clone()
+            };
+
+            let sprites = paint(window, TransformationMatrix::unit());
+            assert_eq!(sprites.len(), 1);
+            assert_eq!(sprites[0].bounds, window.snap_bounds(bounds));
+            assert_eq!(sprites[0].transformation, TransformationMatrix::unit());
+
+            let rotation = TransformationMatrix::unit()
+                .translate(point(ScaledPixels(40.), ScaledPixels(30.)))
+                .rotate(radians(0.5));
+            let sprites = window.with_element_opacity(Some(0.5), |window| paint(window, rotation));
+            assert_eq!(sprites.len(), 1);
+            assert_eq!(sprites[0].bounds, bounds.scale(scale));
+            assert_eq!(sprites[0].transformation, rotation);
+            assert_eq!(sprites[0].opacity, 0.5);
+
+            // Far outside the content mask before the transformation, inside it after.
+            let far = Bounds::new(point(px(-3000.), px(0.)), size(px(10.), px(10.)));
+            let back = TransformationMatrix::unit()
+                .translate(point(ScaledPixels(3000. * scale), ScaledPixels(0.)));
+            window.next_frame.scene.clear();
+            window
+                .paint_image_transformed(
+                    far,
+                    far,
+                    Corners::default(),
+                    image.clone(),
+                    0,
+                    false,
+                    back,
+                )
+                .expect("image paints");
+            assert_eq!(window.next_frame.scene.polychrome_sprites.len(), 1);
+        });
+    }
