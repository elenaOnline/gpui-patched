+fn is_unit_transformation(transform: TransformationMatrix) -> bool {
+    return all(transform.rotation_scale[0] == vec2<f32>(1.0, 0.0))
+        && all(transform.rotation_scale[1] == vec2<f32>(0.0, 1.0))
+        && all(transform.translation == vec2<f32>(0.0));
+}
+
+struct TransformedSpriteVertex {
+    device_position: vec4<f32>,
+    tile_position: vec2<f32>,
+    // The vertex in the sprite's own space (its bounds, before the transformation), and as a
+    // fraction of its bounds.
+    sprite_position: vec2<f32>,
+    unit_position: vec2<f32>,
+}
+
+// A sprite vertex. The edges of a transformed sprite fall between device pixels, so its quad
+// grows by a device pixel on every side and the fragment shader anti-aliases the edges (see
+// `transformed_quad_sdf`); an untransformed sprite keeps its exact quad.
+fn transformed_sprite_vertex(unit_vertex: vec2<f32>, bounds: Bounds, transform: TransformationMatrix, tile: AtlasTile) -> TransformedSpriteVertex {
+    //Note: Rust side stores it as row-major, so transposing here
+    let linear = transpose(transform.rotation_scale);
+    // One device pixel across the sprite's vertical and horizontal edges, in its own units.
+    let area = abs(determinant(linear));
+    var margin = vec2<f32>(0.0);
+    if (!is_unit_transformation(transform) && area > 0.0) {
+        margin = vec2<f32>(length(linear[1]), length(linear[0])) / area;
+    }
+    let unit_position = (unit_vertex * (bounds.size + 2.0 * margin) - margin) / bounds.size;
+    let sprite_position = bounds.origin + unit_position * bounds.size;
+    let atlas_size = vec2<f32>(textureDimensions(t_sprite, 0));
+
+    var result = TransformedSpriteVertex();
+    result.device_position = to_device_position_impl(linear * sprite_position + transform.translation);
+    result.tile_position = (vec2<f32>(tile.bounds.origin) + unit_position * vec2<f32>(tile.bounds.size)) / atlas_size;
+    result.sprite_position = sprite_position;
+    result.unit_position = unit_position;
+    return result;
+}
+
+// Keeps samples on the tile's own texels: a scaled sprite's edge pixels (and a transformed
+// sprite's anti-aliasing margin) would otherwise blend in the neighboring atlas texels.
+fn clamp_to_tile(tile_position: vec2<f32>, tile: AtlasTile) -> vec2<f32> {
+    let atlas_size = vec2<f32>(textureDimensions(t_sprite, 0));
+    let tile_origin = vec2<f32>(tile.bounds.origin);
+    let tile_size = vec2<f32>(tile.bounds.size);
+    return clamp(tile_position, (tile_origin + 0.5) / atlas_size, (tile_origin + tile_size - 0.5) / atlas_size);
+}
