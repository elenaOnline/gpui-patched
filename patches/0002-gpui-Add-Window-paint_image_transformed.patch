+    result.device_position = to_device_position_impl(mul(sprite_position, transformation.rotation_scale) + transformation.translation);
+    result.tile_position = (float2(tile.bounds.origin) + unit_position * float2(tile.bounds.size)) / atlas_size;
+    result.sprite_position = sprite_position;
+    result.unit_position = unit_position;
