+    /// The area the primitive paints: its bounds, or for a transformed sprite the bounding box
+    /// of its transformed bounds (with the device pixel its anti-aliased edges extend into).
+    pub fn painted_bounds(&self) -> Bounds<ScaledPixels> {
+        let (bounds, transformation) = match self {
+            Primitive::MonochromeSprite(sprite) => (sprite.bounds, sprite.transformation),
+            Primitive::SubpixelSprite(sprite) => (sprite.bounds, sprite.transformation),
+            Primitive::PolychromeSprite(sprite) => (sprite.bounds, sprite.transformation),
+            _ => return *self.bounds(),
+        };
+        if transformation == TransformationMatrix::unit() {
+            return bounds;
+        }
+        transformation
+            .transform_bounds(bounds)
+            .dilate(ScaledPixels(1.))
+    }
