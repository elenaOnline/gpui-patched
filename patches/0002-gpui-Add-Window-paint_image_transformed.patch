+bool is_unit_transformation(TransformationMatrix transformation) {
+  return transformation.rotation_scale[0][0] == 1. &&
+         transformation.rotation_scale[0][1] == 0. &&
+         transformation.rotation_scale[1][0] == 0. &&
+         transformation.rotation_scale[1][1] == 1. &&
+         transformation.translation[0] == 0. && transformation.translation[1] == 0.;
+}
+
+float2 transform_point(float2 point, TransformationMatrix transformation) {
+  return float2(point.x * transformation.rotation_scale[0][0] +
+                    point.y * transformation.rotation_scale[0][1] +
+                    transformation.translation[0],
+                point.x * transformation.rotation_scale[1][0] +
+                    point.y * transformation.rotation_scale[1][1] +
+                    transformation.translation[1]);
+}
+
+// A sprite vertex. The edges of a transformed sprite fall between device pixels, so its quad
+// grows by a device pixel on every side and the fragment shader anti-aliases the edges (see
+// `transformed_quad_sdf`); an untransformed sprite keeps its exact quad.
+TransformedSpriteVertex transformed_sprite_vertex(float2 unit_vertex, Bounds_ScaledPixels bounds,
+                                                  TransformationMatrix transformation,
+                                                  AtlasTile tile,
+                                                  constant Size_DevicePixels *viewport_size,
+                                                  constant Size_DevicePixels *atlas_size) {
+  float2 origin = float2(bounds.origin.x, bounds.origin.y);
+  float2 size = float2(bounds.size.width, bounds.size.height);
+  // One device pixel across the sprite's vertical and horizontal edges, in its own units.
+  float2 x_axis = float2(transformation.rotation_scale[0][0], transformation.rotation_scale[1][0]);
+  float2 y_axis = float2(transformation.rotation_scale[0][1], transformation.rotation_scale[1][1]);
+  float area = fabs(x_axis.x * y_axis.y - x_axis.y * y_axis.x);
+  float2 margin = float2(0.);
+  if (!is_unit_transformation(transformation) && area > 0.) {
+    margin = float2(length(y_axis), length(x_axis)) / area;
+  }
+  float2 unit_position = (unit_vertex * (size + 2. * margin) - margin) / size;
+  float2 sprite_position = origin + unit_position * size;
+
+  float2 viewport = float2((float)viewport_size->width, (float)viewport_size->height);
+  float2 device_point = transform_point(sprite_position, transformation);
+  float2 tile_origin = float2(tile.bounds.origin.x, tile.bounds.origin.y);
+  float2 tile_size = float2(tile.bounds.size.width, tile.bounds.size.height);
+
+  TransformedSpriteVertex result;
+  result.device_position =
+      float4(device_point / viewport * float2(2., -2.) + float2(-1., 1.), 0., 1.);
+  result.tile_position = (tile_origin + unit_position * tile_size) /
+                         float2((float)atlas_size->width, (float)atlas_size->height);
+  result.sprite_position = sprite_position;
+  result.unit_position = unit_position;
+  return result;
+}
+
+// Keeps samples on the tile's own texels: a scaled sprite's edge pixels (and a transformed
+// sprite's anti-aliasing margin) would otherwise blend in the neighboring atlas texels.
+float2 clamp_to_tile(float2 tile_position, AtlasTile tile, texture2d<float> atlas_texture) {
+  float2 atlas_size = float2(atlas_texture.get_width(), atlas_texture.get_height());
+  float2 tile_origin = float2(tile.bounds.origin.x, tile.bounds.origin.y);
+  float2 tile_size = float2(tile.bounds.size.width, tile.bounds.size.height);
+  return clamp(tile_position, (tile_origin + 0.5) / atlas_size,
+               (tile_origin + tile_size - 0.5) / atlas_size);
+}
+
+// Signed distance, in device pixels, from a point in a transformed sprite's own space to its
+// rounded bounds: the distance in the sprite's space over its gradient on the screen, which
+// holds under any rotation, scale or skew. Call it in uniform control flow.
+float transformed_quad_sdf(float2 sprite_position, Bounds_ScaledPixels bounds,
+                           Corners_ScaledPixels corner_radii) {
+  float distance = quad_sdf(sprite_position, bounds, corner_radii);
+  float2 gradient = float2(dfdx(distance), dfdy(distance));
+  return distance / max(length(gradient), 1e-6);
+}
