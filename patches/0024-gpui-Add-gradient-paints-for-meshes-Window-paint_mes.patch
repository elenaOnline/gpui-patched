+    return float4(previous.color[0], previous.color[1], previous.color[2], previous.color[3]);
+  }
+  for (uint i = 1; i < g.stop_count; i++) {
+    MeshGradientStopInstance stop = s[i];
+    if (t < stop.offset) {
+      float k = (t - previous.offset) / (stop.offset - previous.offset);
+      float4 from = float4(previous.color[0], previous.color[1], previous.color[2],
+                           previous.color[3]);
+      float4 to = float4(stop.color[0], stop.color[1], stop.color[2], stop.color[3]);
+      return mix(from, to, k);
+    }
+    previous = stop;
+  }
+  return last_color;
+}
