+// The straight colour of a mesh gradient at `p` (its own space), as `MeshGradient::color_at`
+// computes it; transparent where a conical gradient paints nothing.
+float4 mesh_gradient_color(MeshGradientInstance g, device const MeshGradientStopInstance *stops,
+                           float2 p) {
+  device const MeshGradientStopInstance *s = stops + g.first_stop;
+  MeshGradientStopInstance last = s[g.stop_count - 1];
+  float4 last_color = float4(last.color[0], last.color[1], last.color[2], last.color[3]);
+  if (g.kind == 2) {
+    return last_color;
+  }
+  float2 start = float2(g.start[0], g.start[1]);
+  float2 end = float2(g.end[0], g.end[1]);
+  float t;
+  if (g.kind == 0) {
+    float2 d = end - start;
+    t = dot(p - start, d) / dot(d, d);
+  } else {
+    // |p - c(t)| = r(t) for c(t) = c0 + t (c1 - c0), r(t) = r0 + t (r1 - r0):
+    // a t² - 2 b t + c = 0, the largest root whose radius is not negative
+    float2 cd = end - start;
+    float2 pd = p - start;
+    float r0 = g.start_radius;
+    float dr = g.end_radius - r0;
+    float a = dot(cd, cd) - dr * dr;
+    float b = dot(pd, cd) + r0 * dr;
+    float c = dot(pd, pd) - r0 * r0;
+    if (abs(a) <= 1e-6 * (dot(cd, cd) + dr * dr)) {
+      t = c / (2. * b);
+      if (!isfinite(t) || r0 + t * dr < 0.) {
+        return float4(0.);
+      }
+    } else {
+      float discriminant = b * b - a * c;
+      if (discriminant < 0.) {
+        return float4(0.);
+      }
+      float root = sqrt(discriminant);
+      float t0 = (b - root) / a;
+      float t1 = (b + root) / a;
+      float high = max(t0, t1);
+      float low = min(t0, t1);
+      if (r0 + high * dr >= 0.) {
+        t = high;
+      } else if (r0 + low * dr >= 0.) {
+        t = low;
+      } else {
+        return float4(0.);
+      }
+    }
+  }
+  if (g.spread == 0) {
+    t = saturate(t);
+  } else if (g.spread == 2) {
+    t = t - floor(t);
+  } else {
+    float u = fmod(abs(t), 2.);
+    t = u > 1. ? 2. - u : u;
+  }
