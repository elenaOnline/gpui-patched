+        // a hard edge where two stops share an offset
+        let mut hard = linear(MeshGradientSpread::Pad);
+        hard.stops.insert(
+            1,
+            MeshGradientStop {
+                offset: 0.5,
+                color: red,
+            },
+        );
+        hard.stops.insert(
+            2,
+            MeshGradientStop {
+                offset: 0.5,
+                color: clear_blue,
+            },
