+        assert!((at(MeshGradientSpread::Repeat, 12.5) - 0.75).abs() < 1e-5);
+        assert!((at(MeshGradientSpread::Reflect, 12.5) - 0.25).abs() < 1e-5);
+        assert!((at(MeshGradientSpread::Reflect, -2.5) - 0.75).abs() < 1e-5);
