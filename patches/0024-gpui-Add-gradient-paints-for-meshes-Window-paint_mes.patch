+        let half = linear(MeshGradientSpread::Pad).color_at(point(5., 3.)).unwrap();
+        assert!((half.r - 0.5).abs() < 1e-6 && (half.b - 0.5).abs() < 1e-6);
+        assert!((half.a - 0.5).abs() < 1e-6);
