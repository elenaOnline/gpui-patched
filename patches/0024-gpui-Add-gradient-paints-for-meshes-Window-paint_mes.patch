+        to_gradient: gradient.to_gradient,
+        kind,
+        spread: match gradient.spread {
+            MeshGradientSpread::Pad => 0,
+            MeshGradientSpread::Reflect => 1,
+            MeshGradientSpread::Repeat => 2,
+        },
+        first_stop,
+        stop_count: gradient.stops.len() as u32,
+        start,
+        end,
+        start_radius,
+        end_radius,
+    }
 }
 
