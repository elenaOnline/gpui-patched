+    ///
+    /// `transformation` maps mesh space to window pixels (the space element bounds are in).
+    /// Each triangle is filled with its vertices' colour multiplied by `paint`: solid white
+    /// draws the vertex colours as they are, translucent white fades them, and a pattern or
+    /// gradient is drawn in them (white vertices draw it as it is; a gradient spans the
+    /// draw's bounds within the content mask, as a path's does). Meshes are anti-aliased
+    /// the way paths are, by multisampling, and rasterized in paint order with them.
+    ///
+    /// The mesh is uploaded to the GPU the first time it is painted and stays there while it
+    /// is in use, so painting it again costs the same whatever its size.
+    ///
+    /// This method should only be called as part of the paint phase of element drawing.
+    pub fn paint_mesh(
+        &mut self,
+        mesh: &Mesh,
+        transformation: TransformationMatrix,
+        paint: impl Into<Background>,
+    ) {
+        self.invalidator.debug_assert_paint();
+        if mesh.is_empty() {
+            return;
+        }
+        let scale_factor = self.scale_factor();
+        let transformation = TransformationMatrix {
+            rotation_scale: transformation
+                .rotation_scale
+                .map(|row| row.map(|value| value * scale_factor)),
+            translation: transformation.translation.map(|value| value * scale_factor),
+        };
+        let mesh_bounds = mesh.bounds();
+        let transformed = transformation.transform_bounds(Bounds {
+            origin: mesh_bounds.origin.map(ScaledPixels),
+            size: mesh_bounds.size.map(ScaledPixels),
+        });
+        let (top_left, bottom_right) = (transformed.origin, transformed.bottom_right());
+        if ![top_left.x, top_left.y, bottom_right.x, bottom_right.y]
+            .iter()
+            .all(|value| value.0.is_finite())
+        {
+            return;
+        }
+        // Whole device pixels, so compositing the multisampled triangles never cuts off the
+        // anti-aliased pixels at their edges.
+        let bounds = Bounds::from_corners(
+            point(
+                ScaledPixels(top_left.x.0.floor()),
+                ScaledPixels(top_left.y.0.floor()),
+            ),
+            point(
+                ScaledPixels(bottom_right.x.0.ceil()),
+                ScaledPixels(bottom_right.y.0.ceil()),
+            ),
+        );
+        let paint: Background = paint.into();
+        let opacity = self.element_opacity();
+        let content_mask = self.content_mask().scale(scale_factor);
+        self.next_frame.scene.insert_primitive(MeshDraw {
+            order: 0,
+            bounds,
+            content_mask,
+            transformation,
+            background: paint.opacity(opacity).scale(scale_factor),
+            mesh: mesh.clone(),
+        });
+    }
