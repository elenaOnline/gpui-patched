+/*
+**
+**              Meshes
+**
+*/
+
+// Retained meshes (`Window::paint_mesh`) for a renderer that keeps their vertices in a GPU
+// buffer, as the Metal renderer does: a batch is one instanced draw with an instance per block
+// of a draw's mesh (`MeshChunk`), `MESH_BLOCK_VERTICES` vertices each. (This renderer does not
+// use these entry points yet: it rasterizes meshes through the path pipeline.)
+
+static const uint MESH_BLOCK_VERTICES = 48;
+
+struct MeshVertex {
+    float2 position;
+    // red and green, blue and alpha, 16 bits each
+    uint rg;
+    uint ba;
+};
+
+struct MeshDrawInstance {
+    TransformationMatrix transformation;
+    Background background;
+    // what a gradient spans: the clipped bounds, as for paths
+    Bounds bounds;
+    Bounds clip_bounds;
+    uint first_chunk;
+    uint vertex_count;
+};
+
+struct MeshChunk {
+    uint draw;
+    // (one vertex buffer here: blocks are addressed by their first vertex in it)
+    uint page;
+    uint first_vertex;
+};
+
+StructuredBuffer<MeshDrawInstance> mesh_draws: register(t1);
+StructuredBuffer<MeshChunk> mesh_chunks: register(t2);
+StructuredBuffer<MeshVertex> mesh_vertices: register(t3);
+
+struct MeshVertexOutput {
+    float4 position: SV_Position;
+    nointerpolation float4 color: COLOR0;
+    nointerpolation float4 paint_solid: COLOR1;
+    nointerpolation float4 paint_color0: COLOR2;
+    nointerpolation float4 paint_color1: COLOR3;
+    nointerpolation uint draw_id: TEXCOORD0;
+    float4 clip_distance: SV_ClipDistance;
+};
+
+float4 unpack_unorm16(uint rg, uint ba) {
+    return float4(rg & 0xffff, rg >> 16, ba & 0xffff, ba >> 16) / 65535.0;
+}
+
+MeshVertexOutput mesh_vertex(uint vertex_id: SV_VertexID, uint chunk_id: SV_InstanceID) {
+    MeshChunk chunk = mesh_chunks[chunk_id];
+    MeshDrawInstance draw = mesh_draws[chunk.draw];
+    MeshVertexOutput output = (MeshVertexOutput)0;
+    output.draw_id = chunk.draw;
+    uint index = (chunk_id - draw.first_chunk) * MESH_BLOCK_VERTICES + vertex_id;
+    if (index >= draw.vertex_count) {
+        // past the end of the draw's last block: a degenerate triangle
+        output.position = float4(0.0, 0.0, 0.0, 1.0);
+        output.clip_distance = float4(-1.0, -1.0, -1.0, -1.0);
+        return output;
+    }
+    MeshVertex v = mesh_vertices[chunk.first_vertex + vertex_id];
+    float2 position = mul(v.position, draw.transformation.rotation_scale) + draw.transformation.translation;
+    output.position = float4(position / global_viewport_size * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);
+    output.color = unpack_unorm16(v.rg, v.ba);
+    GradientColor paint = prepare_gradient_color(
+        draw.background.tag,
+        draw.background.color_space,
+        draw.background.solid,
+        draw.background.colors
+    );
+    output.paint_solid = paint.solid;
+    output.paint_color0 = paint.color0;
+    output.paint_color1 = paint.color1;
+    output.clip_distance = distance_from_clip_rect_impl(position, draw.clip_bounds);
+    return output;
+}
+
+float4 mesh_fragment(MeshVertexOutput input): SV_Target {
+    MeshDrawInstance draw = mesh_draws[input.draw_id];
+    float4 paint = gradient_color(draw.background, input.position.xy, draw.bounds,
+        input.paint_solid, input.paint_color0, input.paint_color1);
+    float4 color = input.color * paint;
+    return float4(color.rgb * color.a, color.a);
+}
