+// A batch of meshes is one instanced draw with an instance per block of a draw's mesh
+// (`MeshChunk`), `block_vertices` vertices each, read from the chunk's vertex page. Vertices
+// past the end of a draw's last block collapse to a point, so their triangles are never
+// rasterized.
+vertex MeshVertexOutput mesh_vertex(
+  uint vertex_id [[vertex_id]],
+  uint chunk_id [[instance_id]],
+  device const MeshDrawInstance *draws [[buffer(MeshInputIndex_Draws)]],
+  device const MeshChunk *chunks [[buffer(MeshInputIndex_Chunks)]],
+  constant Size_DevicePixels *viewport_size [[buffer(MeshInputIndex_ViewportSize)]],
+  constant uint *block_vertices [[buffer(MeshInputIndex_BlockVertices)]],
+  device const MeshVertex *page0 [[buffer(MeshInputIndex_Page0)]],
+  device const MeshVertex *page1 [[buffer(MeshInputIndex_Page1)]],
+  device const MeshVertex *page2 [[buffer(MeshInputIndex_Page2)]],
+  device const MeshVertex *page3 [[buffer(MeshInputIndex_Page3)]],
+  device const MeshVertex *page4 [[buffer(MeshInputIndex_Page4)]],
+  device const MeshVertex *page5 [[buffer(MeshInputIndex_Page5)]],
+  device const MeshVertex *page6 [[buffer(MeshInputIndex_Page6)]],
+  device const MeshVertex *page7 [[buffer(MeshInputIndex_Page7)]]
+) {
+  MeshChunk chunk = chunks[chunk_id];
+  MeshDrawInstance draw = draws[chunk.draw];
+  uint index = (chunk_id - draw.first_chunk) * *block_vertices + vertex_id;
+  if (index >= draw.vertex_count) {
+    return MeshVertexOutput{
+      float4(0., 0., 0., 1.), float4(0.), float4(0.), float4(0.), float4(0.), chunk.draw,
+      {-1., -1., -1., -1.}
+    };
+  }
+
+  device const MeshVertex *page;
+  switch (chunk.page) {
+    case 0: page = page0; break;
+    case 1: page = page1; break;
+    case 2: page = page2; break;
+    case 3: page = page3; break;
+    case 4: page = page4; break;
+    case 5: page = page5; break;
+    case 6: page = page6; break;
+    default: page = page7; break;
+  }
+  MeshVertex v = page[chunk.first_vertex + vertex_id];
+  float2 position = transform_point(float2(v.position[0], v.position[1]), draw.transformation);
+  float4 device_position = float4(
+    position * float2(2. / viewport_size->width, -2. / viewport_size->height) + float2(-1., 1.),
+    0.,
+    1.
+  );
+  float4 color = float4(unpack_unorm2x16_to_float(v.rg), unpack_unorm2x16_to_float(v.ba));
+  GradientColor paint = prepare_fill_color(
+    draw.background.tag,
+    draw.background.color_space,
+    draw.background.solid,
+    draw.background.colors[0].color,
+    draw.background.colors[1].color
+  );
+  Bounds_ScaledPixels clip = draw.clip_bounds;
+  return MeshVertexOutput{
+    device_position,
+    color,
+    paint.solid,
+    paint.color0,
+    paint.color1,
+    chunk.draw,
+    {
+      position.x - clip.origin.x,
+      clip.origin.x + clip.size.width - position.x,
+      position.y - clip.origin.y,
+      clip.origin.y + clip.size.height - position.y
+    }
+  };
+}
+
+fragment float4 mesh_fragment(
