@@ -134,6 +134,20 @@ type ModifiersChangedListener = Rc<dyn Fn(&ModifiersChangedEvent, &mut Window, &
 pub(crate) struct DispatchActionListener {
     pub(crate) action_type: TypeId,
     pub(crate) listener: Rc<dyn Fn(&dyn Any, DispatchPhase, &mut Window, &mut App)>,
+    /// Whether the action is available here, asked when it is dispatched or its availability
+    /// is queried (menus); `None`: always. An unavailable listener is skipped, as if it were
+    /// not registered.
+    pub(crate) available: Option<ActionAvailability>,
+}
+
+/// Whether an action listener's action is available now (see
+/// [`crate::Window::on_action_available`]).
+pub(crate) type ActionAvailability = Rc<dyn Fn(&App) -> bool>;
+
+impl DispatchActionListener {
+    pub(crate) fn is_available(&self, cx: &App) -> bool {
+        self.available.as_ref().is_none_or(|available| available(cx))
+    }
 }
 
 impl DispatchTree {
@@ -340,6 +354,23 @@ impl DispatchTree {
             .push(DispatchActionListener {
                 action_type,
                 listener,
+                available: None,
+            });
+    }
+
+    /// [`Self::on_action`] for an action that is available only while `available` says so.
+    pub(crate) fn on_action_available(
+        &mut self,
+        action_type: TypeId,
+        available: ActionAvailability,
+        listener: Rc<dyn Fn(&dyn Any, DispatchPhase, &mut Window, &mut App)>,
+    ) {
+        self.active_node()
+            .action_listeners
+            .push(DispatchActionListener {
+                action_type,
+                listener,
+                available: Some(available),
             });
     }
 
@@ -393,6 +424,25 @@ impl DispatchTree {
         false
     }
 
+    /// [`Self::is_action_available`], asking the listeners registered with an availability
+    /// ([`Self::on_action_available`]) whether they are available now.
+    pub fn is_action_available_now(
+        &self,
+        action: &dyn Action,
+        target: DispatchNodeId,
+        cx: &App,
+    ) -> bool {
+        for node_id in self.dispatch_path(target) {
+            let node = &self.nodes[node_id.0];
+            if node.action_listeners.iter().any(|listener| {
+                listener.action_type == action.as_any().type_id() && listener.is_available(cx)
+            }) {
+                return true;
+            }
+        }
+        false
+    }
+
     /// Returns key bindings that invoke an action on the currently focused element. Bindings are
     /// returned in the order they were added. For display, the last binding should take precedence.
     ///
