From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Elena Maher <12779416+elenaOnline@users.noreply.github.com>
Date: Fri, 25 Sep 2026 21:02:24 -0700
Subject: [PATCH] gpui: Add action listeners that are available on demand

An element makes an action available by registering a listener for it while
it paints, so a command that is only sometimes available (a menu bar item that
greys out) had to decide its availability on every frame, whether or not
anyone asked. An editor whose availability walks a large selection paid that
every frame.

Window::on_action_available (and the element's on_action_available) registers
a listener with an availability predicate. It is asked when the action is
dispatched (an unavailable listener is skipped, as if it were not registered,
so the event goes on) and when the action's availability is queried
(Window::is_action_available, which the menu bar's validation uses:
DispatchTree::is_action_available_now); never while the frame is drawn.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/gpui/src/elements/div.rs | 40 ++++++++++++++++++++++++++
 crates/gpui/src/key_dispatch.rs | 50 +++++++++++++++++++++++++++++++++
 crates/gpui/src/window.rs       | 35 +++++++++++++++++++++--
 3 files changed, 122 insertions(+), 3 deletions(-)

diff --git a/crates/gpui/src/elements/div.rs b/crates/gpui/src/elements/div.rs
index 8fcbcac..fac1bb7 100644
--- a/crates/gpui/src/elements/div.rs
+++ b/crates/gpui/src/elements/div.rs
@@ -467,6 +467,27 @@ impl Interactivity {
         ));
     }
 
+    /// Bind the given callback to an action dispatch during the bubble phase, for as long as
+    /// `available` says the action is available (asked on dispatch and when the action's
+    /// availability is queried, see [`Window::on_action_available`]).
+    /// The imperative API equivalent to [`InteractiveElement::on_action_available`].
+    pub fn on_action_available<A: Action>(
+        &mut self,
+        available: impl Fn(&App) -> bool + 'static,
+        listener: impl Fn(&A, &mut Window, &mut App) + 'static,
+    ) {
+        self.available_action_listeners.push((
+            TypeId::of::<A>(),
+            Rc::new(available),
+            Box::new(move |action, phase, window, cx| {
+                let action = action.downcast_ref().unwrap();
+                if phase == DispatchPhase::Bubble {
+                    (listener)(action, window, cx)
+                }
+            }),
+        ));
+    }
+
     /// Bind the given callback to an action dispatch, based on a dynamic action parameter
     /// instead of a type parameter. Useful for component libraries that want to expose
     /// action bindings to their users.
@@ -1105,6 +1126,19 @@ pub trait InteractiveElement: Sized {
         self
     }
 
+    /// Bind the given callback to an action dispatch during the bubble phase, for as long as
+    /// `available` says the action is available (asked when the action is dispatched and when
+    /// its availability is queried, e.g. to enable a menu item; not every frame).
+    /// The fluent API equivalent to [`Interactivity::on_action_available`].
+    fn on_action_available<A: Action>(
+        mut self,
+        available: impl Fn(&App) -> bool + 'static,
+        listener: impl Fn(&A, &mut Window, &mut App) + 'static,
+    ) -> Self {
+        self.interactivity().on_action_available(available, listener);
+        self
+    }
+
     /// Bind the given callback to an action dispatch, based on a dynamic action parameter
     /// instead of a type parameter. Useful for component libraries that want to expose
     /// action bindings to their users.
@@ -2191,6 +2225,7 @@ pub struct Interactivity {
     pub(crate) key_up_listeners: Vec<KeyUpListener>,
     pub(crate) modifiers_changed_listeners: Vec<ModifiersChangedListener>,
     pub(crate) action_listeners: Vec<(TypeId, ActionListener)>,
+    pub(crate) available_action_listeners: Vec<(TypeId, Rc<dyn Fn(&App) -> bool>, ActionListener)>,
     pub(crate) drop_listeners: Vec<(TypeId, DropListener)>,
     pub(crate) can_drop_predicate: Option<CanDropPredicate>,
     pub(crate) click_listeners: Vec<ClickListener>,
@@ -3292,6 +3327,7 @@ impl Interactivity {
         let key_up_listeners = mem::take(&mut self.key_up_listeners);
         let modifiers_changed_listeners = mem::take(&mut self.modifiers_changed_listeners);
         let action_listeners = mem::take(&mut self.action_listeners);
+        let available_action_listeners = mem::take(&mut self.available_action_listeners);
         if let Some(context) = self.key_context.clone() {
             window.set_key_context(context);
         }
@@ -3317,6 +3353,10 @@ impl Interactivity {
         for (action_type, listener) in action_listeners {
             window.on_action(action_type, listener)
         }
+
+        for (action_type, available, listener) in available_action_listeners {
+            window.on_action_available(action_type, available, listener)
+        }
     }
 
     fn paint_hover_group_handler(&self, window: &mut Window, cx: &mut App) {
diff --git a/crates/gpui/src/key_dispatch.rs b/crates/gpui/src/key_dispatch.rs
