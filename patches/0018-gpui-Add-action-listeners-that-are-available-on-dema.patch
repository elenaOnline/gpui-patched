+    /// Register an action listener on this node for the next frame that is available only
+    /// while `available` returns true: it is asked when the action is dispatched (an
+    /// unavailable listener is skipped, as if it were not registered) and when the action's
+    /// availability is queried ([`Self::is_action_available`], e.g. to enable a menu item),
+    /// not while the frame is drawn, so an availability that costs something to decide costs
+    /// it only when someone asks.
+    ///
+    /// This method should only be called as part of the paint phase of element drawing.
+    pub fn on_action_available(
+        &mut self,
+        action_type: TypeId,
+        available: Rc<dyn Fn(&App) -> bool>,
+        listener: impl Fn(&dyn Any, DispatchPhase, &mut Window, &mut App) + 'static,
+    ) {
+        self.invalidator.debug_assert_paint();
+
+        self.next_frame.dispatch_tree.on_action_available(
+            action_type,
+            available,
+            Rc::new(listener),
+        );
+    }
+
     /// Register a capturing action listener on this node for the next frame if the condition is true.
     /// The type of action is determined by the first parameter of the given listener. When the next
     /// frame is rendered the listener will be cleared.
