+/// An underline an input method puts under part of its marked text: the
+/// clauses of a composition, the one being converted drawn thick (on macOS,
+/// the `NSUnderlineStyleAttributeName` runs of the marked text, read as
+/// browsers read them: a style above single is thick).
+#[derive(Clone, Debug, PartialEq)]
+pub struct MarkedTextUnderline {
+    /// The part of the marked text it is under, in UTF-16 code units from
+    /// the start of the marked text.
+    pub range: Range<usize>,
+    /// Thick (the clause being converted) rather than thin.
+    pub thick: bool,
+    /// The colour the input method asks for, if it asks for one.
+    pub color: Option<crate::Rgba>,
+}
+
 /// Zed's interface for handling text input from the platform's IME system
 /// This is currently a 1:1 exposure of the NSTextInputClient API:
 ///
@@ -2145,6 +2183,23 @@ pub trait InputHandler: 'static {
         cx: &mut App,
     );
 
+    /// [`Self::replace_and_mark_text_in_range`], with the input method's
+    /// underlines for the new marked text (its clauses, see
+    /// [`MarkedTextUnderline`]; empty when it gave none). The default
+    /// ignores them.
+    fn replace_and_mark_text_with_underlines(
+        &mut self,
+        range_utf16: Option<Range<usize>>,
+        new_text: &str,
+        new_selected_range: Option<Range<usize>>,
+        underlines: &[MarkedTextUnderline],
+        window: &mut Window,
+        cx: &mut App,
+    ) {
+        let _ = underlines;
+        self.replace_and_mark_text_in_range(range_utf16, new_text, new_selected_range, window, cx)
+    }
+
     /// Remove the IME 'composing' state from the document
     /// Corresponds to [unmarkText()](https://developer.apple.com/documentation/appkit/nstextinputclient/1438239-unmarktext)
     fn unmark_text(&mut self, window: &mut Window, cx: &mut App);
