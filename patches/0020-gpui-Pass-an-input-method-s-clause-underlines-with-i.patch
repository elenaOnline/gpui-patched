+/// The marked text attributes the view reads: the underlines of an input
+/// method's clauses (see [`marked_text_underlines`]).
 extern "C" fn valid_attributes_for_marked_text(_: &Object, _: Sel) -> id {
-    unsafe { msg_send![class!(NSArray), array] }
+    unsafe {
+        let names = [
+            ns_string(UNDERLINE_STYLE_ATTRIBUTE),
+            ns_string(UNDERLINE_COLOR_ATTRIBUTE),
+            ns_string(MARKED_CLAUSE_SEGMENT_ATTRIBUTE),
+        ];
+        msg_send![class!(NSArray), arrayWithObjects: names.as_ptr() count: names.len()]
+    }
+}
+
+/// `NSUnderlineStyleAttributeName`, `NSUnderlineColorAttributeName` and
+/// `NSMarkedClauseSegmentAttributeName`.
+const UNDERLINE_STYLE_ATTRIBUTE: &str = "NSUnderline";
+const UNDERLINE_COLOR_ATTRIBUTE: &str = "NSUnderlineColor";
+const MARKED_CLAUSE_SEGMENT_ATTRIBUTE: &str = "NSMarkedClauseSegment";
+
+/// The underlines of an input method's marked text (an `NSAttributedString`),
+/// as browsers read them: one per run of `NSUnderlineStyleAttributeName`
+/// (each clause of a composition is a run), thick when the style is above
+/// single (the clause being converted), in the run's
+/// `NSUnderlineColorAttributeName` if it has one.
+///
+/// # Safety
+///
+/// `string` is an `NSAttributedString`.
+pub unsafe fn marked_text_underlines(string: id) -> Vec<gpui::MarkedTextUnderline> {
+    let mut underlines = Vec::new();
+    unsafe {
+        let length: NSUInteger = msg_send![string, length];
+        let mut index: NSUInteger = 0;
+        while index < length {
+            let mut run = NSRange::invalid();
+            let attributes: id = msg_send![
+                string,
+                attributesAtIndex: index
+                longestEffectiveRange: &mut run as *mut NSRange as *mut c_void
+                inRange: NSRange::from(index as usize..length as usize)
+            ];
+            let Some(range) = run.to_range().filter(|r| !r.is_empty()) else {
+                break;
+            };
+            let style: id = msg_send![attributes, objectForKey: ns_string(UNDERLINE_STYLE_ATTRIBUTE)];
+            // (the input method's values are only read when they are of the
+            // attribute's type: a message they do not answer would raise an
+            // Objective-C exception, which cannot unwind through this call)
+            if is_kind_of(style, class!(NSNumber)) {
+                let style: NSInteger = msg_send![style, integerValue];
+                let color: id =
+                    msg_send![attributes, objectForKey: ns_string(UNDERLINE_COLOR_ATTRIBUTE)];
+                underlines.push(gpui::MarkedTextUnderline {
+                    range: range.clone(),
+                    thick: style > 1,
+                    color: rgba_of(color),
+                });
+            }
+            index = range.end as NSUInteger;
+        }
+    }
+    underlines
+}
+
+/// Whether `object` is an instance of `class` (or a subclass).
+unsafe fn is_kind_of(object: id, class: &Class) -> bool {
+    if object == nil {
+        return false;
+    }
+    let is: BOOL = unsafe { msg_send![object, isKindOfClass: class] };
+    is == YES
+}
+
+/// An `NSColor` in sRGB, if it is one that converts.
+unsafe fn rgba_of(color: id) -> Option<gpui::Rgba> {
+    if !unsafe { is_kind_of(color, class!(NSColor)) } {
+        return None;
+    }
+    unsafe {
+        let srgb: id = msg_send![class!(NSColorSpace), sRGBColorSpace];
+        let color: id = msg_send![color, colorUsingColorSpace: srgb];
+        if color == nil {
+            return None;
+        }
+        let (mut r, mut g, mut b, mut a): (f64, f64, f64, f64) = (0.0, 0.0, 0.0, 0.0);
+        let _: () = msg_send![color, getRed: &mut r green: &mut g blue: &mut b alpha: &mut a];
+        Some(gpui::Rgba {
+            r: r as f32,
+            g: g as f32,
+            b: b as f32,
+            a: a as f32,
+        })
+    }
 }
 
 extern "C" fn has_marked_text(this: &Object, _: Sel) -> BOOL {
@@ -3541,16 +3632,21 @@ extern "C" fn set_marked_text(
     unsafe {
         let is_attributed_string: BOOL =
             msg_send![text, isKindOfClass: [class!(NSAttributedString)]];
-        let text: id = if is_attributed_string == YES {
-            msg_send![text, string]
+        let (text, underlines): (id, _) = if is_attributed_string == YES {
+            (msg_send![text, string], marked_text_underlines(text))
         } else {
-            text
+            (text, Vec::new())
         };
         let selected_range = selected_range.to_range();
         let replacement_range = replacement_range.to_range();
         let text = text.to_str();
         with_input_handler(this, |input_handler| {
-            input_handler.replace_and_mark_text_in_range(replacement_range, text, selected_range)
+            input_handler.replace_and_mark_text_with_underlines(
+                replacement_range,
+                text,
+                selected_range,
+                &underlines,
+            )
         });
     }
 }
