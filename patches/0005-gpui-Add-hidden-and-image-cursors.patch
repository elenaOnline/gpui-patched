+
+/// Identifies a cursor image registered with
+/// [`App::register_cursor_image`](crate::App::register_cursor_image).
+#[derive(Copy, Clone, Debug, PartialEq, Eq, Hash, Serialize, Deserialize, JsonSchema)]
+pub struct CursorImageId(u64);
+
+impl CursorImageId {
+    pub(crate) fn next() -> Self {
+        static NEXT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(1);
+        Self(NEXT.fetch_add(1, std::sync::atomic::Ordering::Relaxed))
+    }
+}
+
+/// The pixels of a custom cursor (see [`CursorStyle::Image`]).
+#[derive(Clone, Debug)]
+pub struct CursorImage {
+    /// Width in image pixels.
+    pub width: u32,
+    /// Height in image pixels.
+    pub height: u32,
+    /// Straight (not premultiplied) RGBA, 8 bits per channel, row-major, `width × height`.
+    pub rgba: Arc<[u8]>,
+    /// Image pixels per logical pixel (2 for an image drawn at @2x).
+    pub scale_factor: f32,
+    /// The point that clicks, in logical pixels from the top-left corner.
+    pub hotspot: Point<Pixels>,
 }
 
