+    /// Registers a cursor image, to be shown with [`CursorStyle::Image`] like any other cursor
+    /// style (e.g. with [`Window::set_cursor_style`]). Platforms without custom cursors show the
+    /// arrow instead. Unregister images that are no longer needed.
+    pub fn register_cursor_image(&mut self, image: CursorImage) -> CursorImageId {
+        let id = CursorImageId::next();
+        self.platform.register_cursor_image(id, &image);
+        id
+    }
+
+    /// Forgets a cursor image registered with [`App::register_cursor_image`]. Where it is still
+    /// the cursor style, the arrow shows instead.
+    pub fn unregister_cursor_image(&mut self, id: CursorImageId) {
+        self.platform.unregister_cursor_image(id);
+    }
