+/// An owned (+1) `NSCursor`.
+struct OwnedCursor(id);
+
+impl Drop for OwnedCursor {
+    fn drop(&mut self) {
+        // SAFETY: `self.0` is a valid NSCursor we own one reference to.
+        unsafe {
+            let _: () = msg_send![self.0, release];
+        }
+    }
+}
+
+thread_local! {
+    // AppKit objects, used on the main thread only.
+    static CURSOR_IMAGES: std::cell::RefCell<collections::FxHashMap<CursorImageId, OwnedCursor>> =
+        std::cell::RefCell::default();
+    static HIDDEN_CURSOR: id = {
+        let image = CursorImage {
+            width: 1,
+            height: 1,
+            rgba: std::sync::Arc::from([0u8; 4]),
+            scale_factor: 1.,
+            hotspot: point(px(0.), px(0.)),
+        };
+        // Never released: it lives as long as the application.
+        // SAFETY: AppKit main-thread access (thread local of the main thread).
+        unsafe { ns_cursor(&image) }.0
+    };
+}
+
+/// An NSCursor showing `image` (+1 reference).
+///
+/// # Safety
+///
+/// Must be called on the AppKit main thread.
+unsafe fn ns_cursor(image: &CursorImage) -> OwnedCursor {
+    #[allow(non_upper_case_globals)]
+    const NSBitmapFormatAlphaNonpremultiplied: NSUInteger = 1 << 1;
+
+    let width = image.width.max(1);
+    let height = image.height.max(1);
+    let scale = if image.scale_factor > 0. {
+        image.scale_factor as f64
+    } else {
+        1.
+    };
+    let size = NSSize::new(width as f64 / scale, height as f64 / scale);
+    // SAFETY: plain AppKit object creation; the bitmap is sized for `width × height` RGBA and
+    // written within those bounds.
+    unsafe {
+        let rep: id = msg_send![class!(NSBitmapImageRep), alloc];
+        let rep: id = msg_send![rep,
+            initWithBitmapDataPlanes: ptr::null_mut::<*mut u8>()
+            pixelsWide: width as NSInteger
+            pixelsHigh: height as NSInteger
+            bitsPerSample: 8 as NSInteger
+            samplesPerPixel: 4 as NSInteger
+            hasAlpha: YES
+            isPlanar: NO
+            colorSpaceName: ns_string("NSDeviceRGBColorSpace")
+            bitmapFormat: NSBitmapFormatAlphaNonpremultiplied
+            bytesPerRow: (width * 4) as NSInteger
+            bitsPerPixel: 32 as NSInteger
+        ];
+        let data: *mut u8 = msg_send![rep, bitmapData];
+        let len = (width * height * 4) as usize;
+        if !data.is_null() && image.rgba.len() >= len {
+            ptr::copy_nonoverlapping(image.rgba.as_ptr(), data, len);
+        }
+        let _: () = msg_send![rep, setSize: size];
+        let ns_image: id = msg_send![class!(NSImage), alloc];
+        let ns_image: id = msg_send![ns_image, initWithSize: size];
+        let _: () = msg_send![ns_image, addRepresentation: rep];
+        let _: () = msg_send![rep, release];
+        let hotspot = NSPoint::new(
+            f32::from(image.hotspot.x) as f64,
+            f32::from(image.hotspot.y) as f64,
+        );
+        let cursor: id = msg_send![class!(NSCursor), alloc];
+        let cursor: id = msg_send![cursor, initWithImage: ns_image hotSpot: hotspot];
+        let _: () = msg_send![ns_image, release];
+        OwnedCursor(cursor)
+    }
+}
+
+pub(crate) fn register_cursor_image(id: CursorImageId, image: &CursorImage) {
+    // SAFETY: the platform calls this on the AppKit main thread.
+    let cursor = unsafe { ns_cursor(image) };
+    CURSOR_IMAGES.with_borrow_mut(|cursors| cursors.insert(id, cursor));
+}
+
+pub(crate) fn unregister_cursor_image(id: CursorImageId) {
+    CURSOR_IMAGES.with_borrow_mut(|cursors| cursors.remove(&id));
+}
