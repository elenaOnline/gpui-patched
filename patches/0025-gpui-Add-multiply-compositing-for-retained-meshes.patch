-/// Where the mesh run that starts with the meshes at `batches[start]` ends: after the last
-/// batch of meshes reachable from it through sprites and shadows. A renderer rasterizes a run
-/// in one pass through its multisampled path texture, the sprites and shadows painted between
-/// its meshes (a canvas's text, its cards' drop shadows) in order with them.
-pub fn mesh_run_end(batches: &[PrimitiveBatch], start: usize) -> usize {
+/// Where the mesh run that starts with the meshes at `batches[start]` ends. Normal meshes
+/// absorb intervening sprites and shadows into one pass. Other blend modes stop before the
+/// first non-mesh batch, so those primitives keep their normal source-over composition.
+pub fn mesh_run_end(scene: &Scene, batches: &[PrimitiveBatch], start: usize) -> usize {
+    let PrimitiveBatch::Meshes(first) = &batches[start] else {
+        return start + 1;
+    };
+    let blend_mode = scene.meshes[first.start].blend_mode;
     let mut end = start + 1;
     let mut next = start + 1;
     while let Some(batch) = batches.get(next) {
         match batch {
-            PrimitiveBatch::Meshes(_) => {
+            PrimitiveBatch::Meshes(range) if scene.meshes[range.start].blend_mode == blend_mode => {
                 next += 1;
                 end = next;
             }
             PrimitiveBatch::MonochromeSprites { .. }
             | PrimitiveBatch::PolychromeSprites { .. }
-            | PrimitiveBatch::Shadows(_) => next += 1,
+            | PrimitiveBatch::Shadows(_) if blend_mode == MeshBlendMode::Normal => next += 1,
             _ => break,
         }
     }
@@ -584,7 +592,7 @@ impl Scene {
         while next < batches.len() {
             if matches!(batches[next], PrimitiveBatch::Meshes(_)) {
                 passes += 1;
-                next = mesh_run_end(&batches, next);
+                next = mesh_run_end(self, &batches, next);
             } else {
                 next += 1;
             }
@@ -939,6 +947,8 @@ pub struct PathId(pub usize);
