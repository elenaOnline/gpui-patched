 mod tests {
     use std::{
@@ -8359,6 +8483,126 @@ mod tests {
         assert_eq!(observed_drops.borrow().as_slice(), [path]);
     }
 
+    /// Transformed shadows keep their exact bounds in their own space (the transformation places
+    /// them) and carry the transformation; a drop shadow is culled by its transformed bounds
+    /// grown by its blur. Untransformed shadows stay snapped to device pixels.
+    #[gpui::test]
+    fn test_paint_shadows_transformed(cx: &mut TestAppContext) {
+        use crate::{BoxShadow, Corners, ShadowClip, Size, TransformationMatrix, hsla, radians};
+
+        test_underline_paint_at_scales(cx, move |window| {
+            let scale = window.scale_factor();
+            let bounds = Bounds::new(point(px(-1.3), px(2.6)), size(px(10.2), px(5.1)));
+            let drop = BoxShadow::new(px(0.), px(3.), hsla(0., 0., 0., 0.5)).blur_radius(px(4.));
+            let inset = BoxShadow::new(px(0.), px(8.), hsla(0., 0., 0., 0.1))
+                .blur_radius(px(2.))
+                .spread_radius(px(-1.))
+                .inset();
+            let shadows = [drop.clone(), inset];
+            let paint = |window: &mut Window, transformation| {
+                window.next_frame.scene.clear();
+                window.paint_drop_shadows_transformed(
+                    bounds,
+                    Corners::all(px(1.)),
+                    &shadows,
+                    transformation,
+                );
+                window.paint_inset_shadows_transformed(
+                    bounds,
+                    Corners::all(px(1.)),
+                    &shadows,
+                    transformation,
+                );
+                window.next_frame.scene.shadows.clone()
+            };
+
+            let unit = paint(window, TransformationMatrix::unit());
+            assert_eq!(unit.len(), 2);
+            assert_eq!(unit[0].inset, 0);
+            assert_eq!(unit[1].inset, 1);
+
+            // A shadow clip rides along with every shadow painted inside it.
+            let clip = ShadowClip {
+                to_clip: TransformationMatrix::unit().rotate(radians(0.3)),
+                size: size(ScaledPixels(40.), ScaledPixels(30.)),
+            };
+            window.next_frame.scene.clear();
+            window.with_shadow_clip(Some(clip), |window| {
+                window.paint_drop_shadows(bounds, Corners::all(px(1.)), &shadows);
+                window.paint_inset_shadows(bounds, Corners::all(px(1.)), &shadows);
+            });
+            let clipped = window.next_frame.scene.shadows.clone();
+            assert_eq!(clipped.len(), 2);
+            assert!(
+                clipped
+                    .iter()
+                    .all(|s| s.clip_transformation == clip.to_clip && s.clip_size == clip.size)
+            );
+            assert_eq!(unit[0].clip_size, Size::default(), "no clip outside");
+
+            // Outer shadows are drop shadows clipped outside the element (mode 2).
+            window.next_frame.scene.clear();
+            window.paint_outer_shadows_transformed(
+                bounds,
+                Corners::all(px(1.)),
+                &shadows,
+                TransformationMatrix::unit(),
+            );
+            let outer = window.next_frame.scene.shadows.clone();
+            assert_eq!(outer.len(), 1);
+            assert_eq!(outer[0].inset, 2);
+            assert_eq!(outer[0].bounds, unit[0].bounds);
+            assert_eq!(
+                outer[0].painted_geometry(),
+                unit[0].bounds.dilate(unit[0].blur_radius * 3.)
+            );
+            assert_eq!(unit[0].element_bounds, window.cover_bounds(bounds));
+            assert!(
+                unit.iter()
+                    .all(|s| s.transformation == TransformationMatrix::unit())
+            );
+
+            let rotation = TransformationMatrix::unit()
+                .translate(point(ScaledPixels(40.), ScaledPixels(30.)))
+                .rotate(radians(0.5));
+            let rotated = paint(window, rotation);
+            assert_eq!(rotated.len(), 2);
+            assert_eq!(rotated[0].element_bounds, bounds.scale(scale));
+            assert_eq!(
+                rotated[0].bounds,
+                (bounds + point(px(0.), px(3.))).scale(scale)
+            );
+            assert_eq!(
+                rotated[1].bounds,
+                (bounds + point(px(0.), px(8.))).dilate(px(1.)).scale(scale)
+            );
+            assert!(rotated.iter().all(|s| s.transformation == rotation));
+
+            // Out of view before the transformation, in view after it.
+            let back = TransformationMatrix::unit()
+                .translate(point(ScaledPixels(3000. * scale), ScaledPixels(0.)));
+            let far = Bounds::new(point(px(-3000.), px(0.)), size(px(10.), px(10.)));
+            window.next_frame.scene.clear();
+            window.paint_drop_shadows_transformed(
+                far,
+                Corners::default(),
+                std::slice::from_ref(&drop),
+                back,
+            );
+            assert_eq!(window.next_frame.scene.shadows.len(), 1);
+            // Only its blur reaches into view.
+            let edge = Bounds::new(point(px(-3012.), px(0.)), size(px(10.), px(10.)));
+            window.next_frame.scene.clear();
+            window.paint_drop_shadows_transformed(
+                edge,
+                Corners::default(),
+                std::slice::from_ref(&drop),
+                back,
+            );
+            assert_eq!(window.next_frame.scene.shadows.len(), 1);
+        });
+    }
