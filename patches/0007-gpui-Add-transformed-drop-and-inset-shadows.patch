-    /// 0 = drop shadow (rendered outside the element), 1 = inset shadow (rendered inside).
+    /// 0 = drop shadow, 1 = inset shadow (rendered inside the element), 2 = drop shadow
+    /// rendered outside the element only (CSS: an outer box-shadow is clipped inside the
+    /// border box).
     pub inset: u32,
     pub pad: u32, // align to 8 bytes
+    /// Maps the shadow's space (its bounds, element bounds and blur) to the scene, like a
+    /// sprite's transformation.
+    pub transformation: TransformationMatrix,
+    /// A turned rectangle the shadow is clipped to (see [`crate::ShadowClip`]): scene →
+    /// the rectangle's own space, where it spans `clip_size` from the origin. No clip when
+    /// `clip_size` is empty.
+    pub clip_transformation: TransformationMatrix,
+    pub clip_size: Size<ScaledPixels>,
+}
+
+impl Shadow {
+    /// The quad the shadow is rasterized over, in its own space: the element for an inset
+    /// shadow, else the shadow rect with room for the gaussian tail.
+    pub fn painted_geometry(&self) -> Bounds<ScaledPixels> {
+        if self.inset == 1 {
+            self.element_bounds
+        } else {
+            self.bounds.dilate(self.blur_radius * 3.)
+        }
+    }
 }
 
