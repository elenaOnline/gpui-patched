-      {clip_distance.x, clip_distance.y, clip_distance.z, clip_distance.w}};
+      {clip_distance.x, clip_distance.y, clip_distance.z, clip_distance.w},
+      shadow_position};
 }
 
 fragment float4 shadow_fragment(ShadowFragmentInput input [[stage_in]],
@@ -518,11 +525,20 @@ fragment float4 shadow_fragment(ShadowFragmentInput input [[stage_in]],
                                 [[buffer(ShadowInputIndex_Shadows)]]) {
   Shadow shadow = shadows[input.shadow_id];
 
+  // A transformed shadow is evaluated in its own space; its hard edges are anti-aliased by
+  // their screen-space gradient (computed here, in uniform control flow).
+  bool transformed = !is_unit_transformation(shadow.transformation);
+  float2 position = input.shadow_position;
+  float transformed_distance =
+      transformed_quad_sdf(position, shadow.bounds, shadow.corner_radii);
+  float transformed_element_distance = transformed_quad_sdf(
+      position, shadow.element_bounds, shadow.element_corner_radii);
+
   float2 origin = float2(shadow.bounds.origin.x, shadow.bounds.origin.y);
   float2 size = float2(shadow.bounds.size.width, shadow.bounds.size.height);
   float2 half_size = size / 2.;
   float2 center = origin + half_size;
-  float2 point = input.position.xy - center;
+  float2 point = position - center;
   float corner_radius;
   if (point.x < 0.) {
     if (point.y < 0.) {
@@ -540,7 +556,9 @@ fragment float4 shadow_fragment(ShadowFragmentInput input [[stage_in]],
 
   float alpha;
   if (shadow.blur_radius == 0.) {
-    float distance = quad_sdf(input.position.xy, shadow.bounds, shadow.corner_radii);
+    float distance = transformed
+        ? transformed_distance
+        : quad_sdf(position, shadow.bounds, shadow.corner_radii);
     alpha = saturate(0.5 - distance);
   } else {
     // The signal is only non-zero in a limited range, so don't waste samples
@@ -561,13 +579,24 @@ fragment float4 shadow_fragment(ShadowFragmentInput input [[stage_in]],
     }
   }
 
-  if (shadow.inset != 0u) {
+  float element_distance = transformed
+      ? transformed_element_distance
+      : quad_sdf(position, shadow.element_bounds, shadow.element_corner_radii);
+  if (shadow.inset == 1u) {
     // The inset shadow is the complement of the (blurred) hole rect, clipped to the element.
     // `saturate(0.5 - d)` gives a 1-pixel antialiased edge: d <= -0.5 -> 1, d >= 0.5 -> 0.
     alpha = 1. - alpha;
-    float element_distance = quad_sdf(input.position.xy, shadow.element_bounds,
-                                      shadow.element_corner_radii);
     alpha *= saturate(0.5 - element_distance);
+  } else if (shadow.inset == 2u) {
+    // An outer shadow is clipped inside the element, as CSS clips a box-shadow.
+    alpha *= saturate(0.5 + element_distance);
+  }
+  if (shadow.clip_size.width > 0.) {
+    // The shadow clip: a turned rectangle, in pixel units in its own space.
+    float2 p = transform_point(input.position.xy, shadow.clip_transformation);
+    float d = max(max(-p.x, p.x - shadow.clip_size.width),
+                  max(-p.y, p.y - shadow.clip_size.height));
+    alpha *= saturate(0.5 - d);
   }
 
   return input.color * float4(1., 1., 1., alpha);
