+    /// Rasterizes the glyphs painted within `f` with the given font smoothing, e.g.
+    /// [`FontSmoothing::Antialiased`] to match web content styled with
+    /// `-webkit-font-smoothing: antialiased`. This method should only be called during the
+    /// prepaint or paint phase of element drawing.
+    pub fn with_font_smoothing<R>(
+        &mut self,
+        font_smoothing: FontSmoothing,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> R {
+        self.invalidator.debug_assert_paint_or_prepaint();
+
+        let previous = std::mem::replace(&mut self.font_smoothing, font_smoothing);
+        let result = f(self);
+        self.font_smoothing = previous;
+        result
+    }
+
     /// Perform prepaint on child elements in a "retryable" manner, so that any side effects
     /// of prepaints can be discarded before prepainting again. This is used to support autoscroll
     /// where we need to prepaint children to detect the autoscroll bounds, then adjust the
@@ -4691,9 +4710,16 @@ impl Window {
             (quantized_origin.y.fract() * SUBPIXEL_VARIANTS_Y as f32) as u8,
         );
         let integer_origin = quantized_origin.map(|c| ScaledPixels(c.trunc()));
-        let subpixel_rendering = transformation == TransformationMatrix::unit()
+        let font_smoothing = self.font_smoothing;
+        let smoothed = font_smoothing == FontSmoothing::PlatformDefault;
+        let subpixel_rendering = smoothed
+            && transformation == TransformationMatrix::unit()
             && self.should_use_subpixel_rendering(font_id, font_size);
-        let dilation = self.text_system().glyph_dilation_for_color(color);
+        let dilation = if smoothed {
+            self.text_system().glyph_dilation_for_color(color)
+        } else {
+            0
+        };
         let params = RenderGlyphParams {
             font_id,
             glyph_id,
@@ -4703,6 +4729,7 @@ impl Window {
             is_emoji: false,
             subpixel_rendering,
             dilation,
+            font_smoothing,
         };
 
         let raster_bounds = self.text_system().raster_bounds(&params)?;
@@ -4814,6 +4841,7 @@ impl Window {
             is_emoji: true,
             subpixel_rendering: false,
             dilation: 0,
+            font_smoothing: FontSmoothing::default(),
         };
 
         let raster_bounds = self.text_system().raster_bounds(&params)?;
