+impl Drop for MacPlatform {
+    fn drop(&mut self) {
+        // An embedded platform's observer points at it: stop its notifications, clear the
+        // pointer (work already queued for the main thread holds the observer, and finds no
+        // platform) and release it.
+        if let Some(observer) = self.0.get_mut().embedded_observer.take() {
+            // SAFETY: the observer was created by `run_embedded` and is owned here.
+            unsafe {
+                let center: id = msg_send![class!(NSNotificationCenter), defaultCenter];
+                let _: () = msg_send![center, removeObserver: observer];
+                NSWorkspace::sharedWorkspace()
+                    .notificationCenter()
+                    .removeObserver(&*(observer as *const AnyObject));
+                (*observer).set_ivar(MAC_PLATFORM_IVAR, null_mut::<c_void>());
+                let _: () = msg_send![observer, release];
+            }
+        }
+    }
+}
