+///
+/// # Safety
+///
+/// Main thread only (the ivar is written there, and the platform lives there).
+unsafe fn get_mac_platform(object: &Object) -> Option<&MacPlatform> {
     unsafe {
         let platform_ptr: *mut c_void = *object.get_ivar(MAC_PLATFORM_IVAR);
-        assert!(!platform_ptr.is_null());
