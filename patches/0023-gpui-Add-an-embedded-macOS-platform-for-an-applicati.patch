+
+/// Runs `work` on the main queue with `this` (a `GPUIApplicationDelegate`) as its context,
+/// retained until then; `work` takes it with [`take_deferred_platform`]. For notifications
+/// that may arrive on any thread, or while the app is borrowed.
+///
+/// # Safety
+///
+/// `this` must be a `GPUIApplicationDelegate`.
+unsafe fn defer_to_main_queue(this: &Object, work: extern "C" fn(*mut c_void)) {
+    unsafe {
+        let observer: id = msg_send![this, retain];
+        DispatchQueue::main().exec_async_f(observer as *mut c_void, work);
+    }
+}
+
+/// In work queued by [`defer_to_main_queue`] (on the main thread): releases the observer
+/// and returns the platform it carries, if it still carries one. An embedded platform
+/// may have been dropped since the work was queued.
+///
+/// # Safety
+///
+/// `context` must be the context [`defer_to_main_queue`] passed, taken once.
+unsafe fn take_deferred_platform<'a>(context: *mut c_void) -> Option<&'a MacPlatform> {
+    unsafe {
+        let observer = context as id;
+        let platform = get_mac_platform(&*observer).map(|p| p as *const MacPlatform);
+        let _: () = msg_send![observer, release];
+        platform.map(|p| &*p)
     }
 }
 
