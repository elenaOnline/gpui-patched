+    /// A platform for GPUI inside a native application that owns `NSApp`: its class and
+    /// delegate, the menu bar and Dock menu, the activation policy, quitting and the run
+    /// loop. `Application::run_embedded` then runs its callback at once and returns; call
+    /// it once, when the host has finished launching. The platform is behind an `Rc`
+    /// because running it gives its address to Objective-C, so it must not move.
+    ///
+    /// Windows, input, text, cursors and the main-thread executor work as in a GPUI
+    /// application. What belongs to the application is the host's:
+    ///
+    /// - `set_menus` only keeps the menus for `get_menus` (the host may build its menu bar
+    ///   from them), and `set_dock_menu` does nothing.
+    /// - GPUI's application delegate is not installed, so the handlers set with
+    ///   `on_should_quit`, `on_quit`, `on_reopen`, `on_open_urls` and the app menu ones are
+    ///   never called: the host calls what it needs (`App::shutdown` when it terminates,
+    ///   say). So `App::quit` does not ask `on_should_quit` first; the host's delegate
+    ///   answers instead. Nor is the `NSAutoFillHeuristicControllerEnabled` default that
+    ///   GPUI's delegate sets as the application launches set.
+    /// - System notifications are the host's too: `show_system_notification`,
+    ///   `dismiss_system_notification` and `on_system_notification_response` do nothing,
+    ///   so GPUI never becomes the `UNUserNotificationCenter`'s delegate or replaces its
+    ///   notification categories.
+    ///
+    /// What acts on the application acts on the host's: `quit` asks it to terminate;
+    /// `activate`, `hide`, `hide_other_apps`, `unhide_other_apps` and `reply_to_should_quit`
+    /// act on its `NSApp`; `set_window_appearance` sets the appearance of all its windows;
+    /// a window in simple fullscreen sets its `presentationOptions` while it is. `restart`
+    /// asks it to terminate and starts a helper process that opens it again once it has
+    /// exited (if the host cancels, whenever it exits later); with the `app-store` feature
+    /// `restart` only logs an error.
+    pub fn new_embedded() -> Rc<Self> {
+        let platform = Self::new(false);
+        platform.0.lock().embedded = true;
+        Rc::new(platform)
+    }
+
+    fn run_embedded(&self, on_finish_launching: Box<dyn FnOnce()>) {
+        assert!(
+            self.0.lock().embedded_observer.is_none(),
+            "an embedded platform runs once"
+        );
+        // NSApp is the host's: not a `GPUIApplication`, and without a `platform` ivar.
+        // SAFETY: `APP_DELEGATE_CLASS` is registered at startup and declares the ivar and
+        // the notification handlers. The platform is in an `Rc` (`new_embedded`), so its
+        // address is stable, and `Drop` clears the ivar before it goes.
+        unsafe {
+            let observer: id = msg_send![APP_DELEGATE_CLASS, new];
+            (*observer).set_ivar(MAC_PLATFORM_IVAR, self as *const Self as *const c_void);
+            self.0.lock().embedded_observer = Some(observer);
+            register_app_observers(&mut *observer);
+        }
+        on_finish_launching();
+    }
