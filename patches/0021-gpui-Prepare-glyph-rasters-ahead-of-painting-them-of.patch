+
+    /// A glyph's raster (its size and alpha, or colour, bytes): the one
+    /// [`Self::prepare_glyphs`] kept for it, which this consumes (the next
+    /// call rasterizes again), else the platform's, rasterized now. Painting
+    /// a glyph the sprite atlas does not have calls this. `params.font_id`
+    /// must be a font of this text system: another id panics.
+    pub fn rasterize_glyph(
         &self,
         params: &RenderGlyphParams,
     ) -> Result<(Size<DevicePixels>, Vec<u8>)> {
+        {
+            let mut prepared = self.prepared_glyphs.lock();
+            if let Some(raster) = prepared.take(params) {
+                return Ok(raster);
+            }
+            prepared.painted(params);
+        }
         let raster_bounds = self.raster_bounds(params)?;
         self.platform_text_system
             .rasterize_glyph(params, raster_bounds)
     }
 
+    /// Rasterizes glyphs ahead of their painting, on the calling thread: a
+    /// background one, since rasterizing is what makes painting a glyph the
+    /// sprite atlas does not have yet costly (the platform draws it into a
+    /// bitmap, and on macOS the first glyph of a font at a new size queries
+    /// the font registry). A glyph painted later with the same parameters
+    /// ([`crate::Window::glyph_render_params`]) takes its prepared raster
+    /// instead of rasterizing, once. Prepared rasters are kept up to
+    /// [`MAX_PREPARED_GLYPH_BYTES`], the oldest dropped first, until
+    /// [`Self::release_prepared_glyphs`]; glyphs already prepared, painted
+    /// meanwhile (painting rasterized them), with nothing to draw, or whose
+    /// raster would take more than [`MAX_PREPARED_GLYPH_RASTER_BYTES`] are
+    /// skipped. The font ids must be this text system's: another id panics.
+    pub fn prepare_glyphs(&self, params: &[RenderGlyphParams]) {
+        for params in params {
+            if self.prepared_glyphs.lock().contains(params) {
+                continue;
+            }
+            let Ok(raster_bounds) = self.raster_bounds(params) else {
+                continue;
+            };
+            let (w, h) = (
+                raster_bounds.size.width.0.max(0) as usize,
+                raster_bounds.size.height.0.max(0) as usize,
+            );
+            // (colour glyphs and subpixel ones take four bytes a pixel; a
+            // subpixel variant one more row and column)
+            let per_pixel = if params.is_emoji || params.subpixel_rendering {
+                4
+            } else {
+                1
+            };
+            let bytes = (w + 1) * (h + 1) * per_pixel;
+            if w == 0 || h == 0 || bytes > MAX_PREPARED_GLYPH_RASTER_BYTES {
+                continue;
+            }
+            if let Ok((size, raster)) = self
+                .platform_text_system
+                .rasterize_glyph(params, raster_bounds)
+            {
+                let dropped = self
+                    .prepared_glyphs
+                    .lock()
+                    .insert(params.clone(), size, &raster);
+                // (measured only to be prepared: painting measures again)
+                if !dropped.is_empty() {
+                    self.forget_raster_bounds(dropped);
+                }
+            }
+        }
+    }
+
+    /// Drops every glyph raster [`Self::prepare_glyphs`] kept (their memory
+    /// too): for when the text they were prepared for no longer needs them
+    /// (a zoom ended).
+    pub fn release_prepared_glyphs(&self) {
+        let dropped = self.prepared_glyphs.lock().release();
+        self.forget_raster_bounds(dropped);
+    }
+
+    /// What became of the prepared rasters so far.
+    pub fn prepared_glyph_stats(&self) -> PreparedGlyphStats {
+        self.prepared_glyphs.lock().stats
+    }
