-    pub(crate) fn rasterize_glyph(
+        // Measured without the lock: glyphs prepared on other threads
+        // (`prepare_glyphs`) do not hold up the ones painted meanwhile.
+        let bounds = self.platform_text_system.glyph_raster_bounds(params)?;
