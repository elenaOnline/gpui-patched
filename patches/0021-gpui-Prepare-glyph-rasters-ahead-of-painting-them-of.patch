+/// The most bytes of glyph rasters [`TextSystem::prepare_glyphs`] keeps
+/// (that no painting has taken yet), in 1 MB chunks mapped from the
+/// system: released, they leave the process at once (an
+/// allocator may keep memory freed by another thread than the one that
+/// allocated it, and returns it to the system lazily).
+pub const MAX_PREPARED_GLYPH_BYTES: usize = 16 << 20;
+
+/// Prepared rasters are copied into chunks of this many bytes; a new chunk
+/// that would pass [`MAX_PREPARED_GLYPH_BYTES`] takes the place of the
+/// oldest, whose rasters are dropped.
+const PREPARED_CHUNK_BYTES: usize = 1 << 20;
+
+/// What became of the rasters [`TextSystem::prepare_glyphs`] kept, since the
+/// text system was made: a caller that prepares more than is painted can
+/// tell, and ask for less.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct PreparedGlyphStats {
+    /// Rasters prepared and kept.
+    pub prepared: u64,
+    /// Their bytes.
+    pub prepared_bytes: u64,
+    /// Taken by painting.
+    pub taken: u64,
+    /// Their bytes.
+    pub taken_bytes: u64,
+    /// Dropped unused: the oldest beyond [`MAX_PREPARED_GLYPH_BYTES`], or
+    /// released ([`TextSystem::release_prepared_glyphs`]).
+    pub dropped: u64,
+    /// Rasterized too late: painting had rasterized the glyph itself.
+    pub late: u64,
+    /// Rasterized but not kept: no memory could be mapped for it.
+    pub failed: u64,
+}
+
+/// A glyph whose raster would take more than this is not prepared (painting
+/// it rasterizes it as before): no single glyph takes much of
+/// [`MAX_PREPARED_GLYPH_BYTES`], or of the memory preparing it needs.
+pub const MAX_PREPARED_GLYPH_RASTER_BYTES: usize = PREPARED_CHUNK_BYTES / 4;
+
+/// At most this many glyphs painting rasterized itself while glyphs were
+/// being prepared are remembered (not prepared again): past it, the oldest
+/// half is forgotten.
+const MAX_PAINTED_GLYPHS: usize = 16384;
+
+/// A prepared raster: its size, and where its bytes are.
+struct PreparedRaster {
+    size: Size<DevicePixels>,
+    chunk: u64,
+    offset: usize,
+    len: usize,
+}
+
+/// Memory prepared rasters are copied into, one after the other: mapped
+/// from the system on unix (and unmapped when dropped), allocated
+/// elsewhere.
+struct PreparedChunk {
+    ptr: std::ptr::NonNull<u8>,
+    /// Bytes written, from the start.
+    used: usize,
+    /// Rasters in it that were neither taken nor dropped.
+    live: usize,
+    /// Chunks are numbered in the order they are started.
+    id: u64,
+}
+
+// SAFETY: a chunk owns its memory, reached only through `&self`/`&mut self`
+// (the text system's lock).
+unsafe impl Send for PreparedChunk {}
+
+impl PreparedChunk {
+    fn new(id: u64) -> Option<Self> {
+        #[cfg(unix)]
+        // SAFETY: a new anonymous private mapping; no other precondition
+        let ptr = unsafe {
+            let ptr = libc::mmap(
+                std::ptr::null_mut(),
+                PREPARED_CHUNK_BYTES,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_PRIVATE | libc::MAP_ANON,
+                -1,
+                0,
+            );
+            if ptr == libc::MAP_FAILED {
+                return None;
+            }
+            ptr.cast::<u8>()
+        };
+        #[cfg(not(unix))]
+        let ptr = Box::into_raw(vec![0u8; PREPARED_CHUNK_BYTES].into_boxed_slice()).cast::<u8>();
+        std::ptr::NonNull::new(ptr).map(|ptr| Self {
+            ptr,
+            used: 0,
+            live: 0,
+            id,
+        })
+    }
+
+    /// Copies `bytes` in after the others: their offset, or `None` when they
+    /// do not fit.
+    fn push(&mut self, bytes: &[u8]) -> Option<usize> {
+        let offset = self.used;
+        if bytes.len() > PREPARED_CHUNK_BYTES - offset {
+            return None;
+        }
+        // SAFETY: within the chunk (checked above), which nothing borrows
+        // (`&mut self`); `bytes` is not in it (only `bytes` borrows it)
+        unsafe {
+            std::ptr::copy_nonoverlapping(bytes.as_ptr(), self.ptr.as_ptr().add(offset), bytes.len())
+        };
+        self.used += bytes.len();
+        self.live += 1;
+        Some(offset)
+    }
+
+    fn bytes(&self, offset: usize, len: usize) -> &[u8] {
+        assert!(offset + len <= self.used, "a prepared raster outside its chunk");
+        // SAFETY: bytes written by `push` (checked above), in the chunk for
+        // as long as `&self`
+        unsafe { std::slice::from_raw_parts(self.ptr.as_ptr().add(offset), len) }
+    }
+
+    /// The chunk emptied, for new rasters.
+    fn reuse(&mut self, id: u64) {
+        self.used = 0;
+        self.live = 0;
+        self.id = id;
+    }
+}
+
+impl Drop for PreparedChunk {
+    fn drop(&mut self) {
+        #[cfg(unix)]
+        // SAFETY: the mapping `new` made, unmapped once
+        unsafe {
+            libc::munmap(self.ptr.as_ptr().cast(), PREPARED_CHUNK_BYTES);
+        }
+        #[cfg(not(unix))]
+        // SAFETY: the box `new` leaked, freed once
+        unsafe {
+            drop(Box::from_raw(std::ptr::slice_from_raw_parts_mut(
+                self.ptr.as_ptr(),
+                PREPARED_CHUNK_BYTES,
+            )));
+        }
+    }
+}
+
+/// Glyph rasters prepared ahead of painting (see
+/// [`TextSystem::prepare_glyphs`]), in chunks oldest first (rasters are
+/// copied into the last), and the glyphs painting rasterized itself
+/// meanwhile.
+#[derive(Default)]
+struct PreparedGlyphs {
+    rasters: FxHashMap<RenderGlyphParams, PreparedRaster>,
+    chunks: VecDeque<PreparedChunk>,
+    next_chunk: u64,
+    painted: FxHashSet<RenderGlyphParams>,
+    painted_order: VecDeque<RenderGlyphParams>,
+    stats: PreparedGlyphStats,
+}
+
+impl PreparedGlyphs {
+    /// Whether the glyph is prepared, or painting rasterized it while
+    /// glyphs were being prepared (preparing it would be too late).
+    fn contains(&self, params: &RenderGlyphParams) -> bool {
+        self.rasters.contains_key(params) || self.painted.contains(params)
+    }
+
+    /// Keeps a copy of a raster (replacing the glyph's, when two threads
+    /// prepared it at once), unless painting rasterized the glyph
+    /// meanwhile. Returns the glyphs dropped unused to keep within
+    /// [`MAX_PREPARED_GLYPH_BYTES`].
+    fn insert(
+        &mut self,
+        params: RenderGlyphParams,
+        size: Size<DevicePixels>,
+        bytes: &[u8],
+    ) -> Vec<RenderGlyphParams> {
+        let mut dropped = Vec::new();
+        if self.painted.contains(&params) {
+            self.stats.late += 1;
+            return dropped;
+        }
+        if bytes.len() > MAX_PREPARED_GLYPH_RASTER_BYTES {
+            return dropped;
+        }
+        if let Some((replaced, _)) = self.remove(&params) {
+            self.stats.prepared -= 1;
+            self.stats.prepared_bytes -= replaced.len as u64;
+        }
+        let pushed = self.chunks.back_mut().and_then(|chunk| chunk.push(bytes));
+        let offset = match pushed {
+            Some(offset) => offset,
+            None => {
+                let pushed = if self.start_chunk(&mut dropped) {
+                    self.chunks.back_mut().and_then(|chunk| chunk.push(bytes))
+                } else {
+                    None
+                };
+                let Some(offset) = pushed else {
+                    self.stats.failed += 1;
+                    return dropped;
+                };
+                offset
+            }
+        };
+        let chunk = self.chunks.back().map_or(0, |chunk| chunk.id);
+        self.rasters.insert(
+            params,
+            PreparedRaster {
+                size,
+                chunk,
+                offset,
+                len: bytes.len(),
+            },
+        );
+        self.stats.prepared += 1;
+        self.stats.prepared_bytes += bytes.len() as u64;
+        dropped
+    }
+
+    /// Starts a chunk after the others: an emptied one, else a new one
+    /// within [`MAX_PREPARED_GLYPH_BYTES`], else the oldest, its rasters
+    /// dropped (added to `dropped`). Whether there is one.
+    fn start_chunk(&mut self, dropped: &mut Vec<RenderGlyphParams>) -> bool {
+        let id = self.next_chunk;
+        self.next_chunk += 1;
+        let chunk = if let Some(i) = self.chunks.iter().position(|chunk| chunk.live == 0) {
+            self.chunks.remove(i)
+        } else if self.chunks.len() < MAX_PREPARED_GLYPH_BYTES / PREPARED_CHUNK_BYTES {
+            PreparedChunk::new(id)
+        } else {
+            let oldest = self.chunks.pop_front();
+            if let Some(oldest) = &oldest {
+                let before = self.rasters.len();
+                self.rasters.retain(|params, raster| {
+                    let keep = raster.chunk != oldest.id;
+                    if !keep {
+                        dropped.push(params.clone());
+                    }
+                    keep
+                });
+                self.stats.dropped += (before - self.rasters.len()) as u64;
+            }
+            oldest
+        };
+        let Some(mut chunk) = chunk else {
+            return false;
+        };
+        chunk.reuse(id);
+        self.chunks.push_back(chunk);
+        true
+    }
+
+    /// Forgets a glyph's raster: the chunk it is in, if any.
+    fn remove(&mut self, params: &RenderGlyphParams) -> Option<(PreparedRaster, &PreparedChunk)> {
+        let raster = self.rasters.remove(params)?;
+        let chunk = self.chunks.iter_mut().find(|chunk| chunk.id == raster.chunk)?;
+        chunk.live -= 1;
+        Some((raster, chunk))
+    }
+
+    fn take(&mut self, params: &RenderGlyphParams) -> Option<(Size<DevicePixels>, Vec<u8>)> {
+        let (raster, chunk) = self.remove(params)?;
+        let bytes = chunk.bytes(raster.offset, raster.len).to_vec();
+        self.stats.taken += 1;
+        self.stats.taken_bytes += raster.len as u64;
+        Some((raster.size, bytes))
+    }
+
+    /// Painting rasterized a glyph itself: while glyphs are being prepared
+    /// (until the release), it is not prepared, or kept, again.
+    fn painted(&mut self, params: &RenderGlyphParams) {
+        if self.chunks.is_empty() || !self.painted.insert(params.clone()) {
+            return;
+        }
+        self.painted_order.push_back(params.clone());
+        if self.painted_order.len() > MAX_PAINTED_GLYPHS {
+            for old in self.painted_order.drain(..MAX_PAINTED_GLYPHS / 2) {
+                self.painted.remove(&old);
+            }
+        }
+    }
+
+    /// Drops every raster kept, and the memory they and the maps took.
+    /// Returns the glyphs dropped.
+    fn release(&mut self) -> Vec<RenderGlyphParams> {
+        let rasters = std::mem::take(&mut self.rasters);
+        self.stats.dropped += rasters.len() as u64;
+        self.chunks = VecDeque::new();
+        self.painted = FxHashSet::default();
+        self.painted_order = VecDeque::new();
+        rasters.into_keys().collect()
+    }
+}
