+    /// continuously changing sizes, such as on a zoomable canvas, which would otherwise grow
+    /// the atlas without bound. Glyphs also painted outside such a scope are kept. This method
+    /// should only be called during the paint phase of element drawing.
+    pub fn with_evictable_glyphs<R>(&mut self, f: impl FnOnce(&mut Self) -> R) -> R {
+        self.invalidator.debug_assert_paint();
+        let previous = std::mem::replace(&mut self.evictable_glyphs, true);
+        let result = f(self);
+        self.evictable_glyphs = previous;
+        result
+    }
