+/// Stylus details of a mouse event that a pen produced (a graphics
+/// tablet's stylus, or a pencil used as one), with the values and ranges
+/// of the web's `PointerEvent` for `pointerType: "pen"`.
+///
+/// Mouse events from mice and trackpads carry no `PenInfo`, and neither do
+/// events on platforms that don't report pens yet (only macOS does).
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct PenInfo {
+    /// The normalized tip pressure in `0.0..=1.0`; `0.0` while the pen
+    /// hovers over the tablet without touching it.
+    pub pressure: f32,
+    /// The pen's tilt in degrees, each axis in `-90.0..=90.0`: `x` is
+    /// positive when the pen leans to the right, `y` when it leans towards
+    /// the user (the web's `tiltX` and `tiltY`).
+    pub tilt: Point<f32>,
+    /// Whether the eraser end of the pen produced the event.
+    pub eraser: bool,
+}
+
 /// A mouse down event from the platform
